+                 'student_id': sid, 'student_name': s.get('student_name'), 'email': (users.get(sid) or {}).get('email'),
+                 'classes': set(), 'assigned': 0, 'submitted': 0, 'late': 0, '_pcts': [], 'last_submitted_at': None, 'latest': None,
+             })
