@@ -0,0 +1,65 @@
+// Test harness: the real Express app on a random port, backed by a fresh
+// in-memory DynamoDB per suite.
+process.env.APP_ENV = 'test'
+
+const { default: jwt } = await import('jsonwebtoken')
+const { default: config } = await import('../src/config/index.js')
+const { createApp } = await import('../src/app.js')
+const dynamo = await import('../src/aws/dynamodb.js')
+
+export { config }
+export const table = dynamo.table
+
+let server
+export let baseUrl
+
+export async function startServer({ assignmentIndex = true, seed = false } = {}) {
+  await stopServer()
+  await dynamo.initDatabase({ seed, assignmentIndex })
+  await new Promise((resolve) => {
+    server = createApp().listen(0, '127.0.0.1', resolve)
+  })
+  baseUrl = `http://127.0.0.1:${server.address().port}`
+  config.server.publicUrl = baseUrl // local-storage URLs must point at this test server
+  return baseUrl
+}
+
+export async function stopServer() {
+  if (server) await new Promise((resolve) => server.close(resolve))
+  server = undefined
+  await dynamo.closeDatabase()
+}
+
+export function tokenFor(user, { secret = config.auth.jwtSecret, expiresIn = 600 } = {}) {
+  return jwt.sign(
+    { email: user.email, user_id: user.user_id, exp: Math.floor(Date.now() / 1000) + expiresIn },
+    secret,
+    { algorithm: 'HS256' },
+  )
+}
+
+/** POST JSON; returns [status, body, headers]. */
+export async function post(path, body, { token, headers = {}, raw } = {}) {
+  const res = await fetch(`${baseUrl}${path}`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json', ...(token ? { Authorization: `Bearer ${token}` } : {}), ...headers },
+    body: raw ?? JSON.stringify(body ?? {}),
+  })
+  const text = await res.text()
+  let json = null
+  try {
+    json = text ? JSON.parse(text) : null
+  } catch {
+    json = text
+  }
+  return [res.status, json, res.headers]
+}
+
+export async function get(path) {
+  const res = await fetch(`${baseUrl}${path}`)
+  return [res.status, await res.json().catch(() => null), res.headers]
+}
+
+export async function putUsers(users) {
+  for (const u of users) await table(config.tables.users).put(u)
+}
diff --git a/backend/test/runtime.test.js b/backend/test/runtime.test.js
new file mode 100644
index 0000000..94ef807
--- /dev/null
+++ b/backend/test/runtime.test.js
@@ -0,0 +1,64 @@
+// The entry point as Lambda Web Functions runs it: index.js must listen on the
+// host:port in AWS_LAMBDA_HTTP_ENDPOINT, quickly, and production config must be
+// validated before the server starts.
+import assert from 'node:assert/strict'
+import { spawn } from 'node:child_process'
+import { createServer } from 'node:net'
+import path from 'node:path'
+import { test } from 'node:test'
+import { fileURLToPath } from 'node:url'
+
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
+
+const freePort = () =>
+  new Promise((resolve) => {
+    const s = createServer().listen(0, '127.0.0.1', () => {
+      const { port } = s.address()
+      s.close(() => resolve(port))
+    })
+  })
+
+function run(env, args = []) {
+  const child = spawn(process.execPath, ['index.js', ...args], {
+    cwd: ROOT,
+    env: { PATH: process.env.PATH, ...env },
+    stdio: ['ignore', 'pipe', 'pipe'],
+  })
+  let output = ''
+  child.stdout.on('data', (d) => (output += d))
+  child.stderr.on('data', (d) => (output += d))
+  const exited = new Promise((resolve) => child.on('exit', (code) => resolve(code)))
+  return { child, exited, output: () => output }
+}
+
+test('listens on AWS_LAMBDA_HTTP_ENDPOINT within the 10 s startup limit', async () => {
+  const port = await freePort()
+  const started = Date.now()
+  const proc = run({ AWS_LAMBDA_HTTP_ENDPOINT: `127.0.0.1:${port}`, APP_ENV: 'test' })
+  try {
+    let res
+    while (!res && Date.now() - started < 10_000) {
+      res = await fetch(`http://127.0.0.1:${port}/health`).catch(() => null)
+      if (!res) await new Promise((r) => setTimeout(r, 100))
+    }
+    assert.ok(res, `server did not listen: ${proc.output()}`)
+    assert.equal(res.status, 200)
+    assert.ok(Date.now() - started < 10_000)
+  } finally {
+    proc.child.kill('SIGTERM')
+    assert.equal(await proc.exited, 0) // graceful SIGTERM shutdown
+  }
+})
+
+test('production refuses to start without its required configuration', async () => {
+  const proc = run({ APP_ENV: 'production', CORS_ALLOWED_ORIGINS: '', JWT_SECRET_ARN: '' })
+  const code = await proc.exited
+  assert.notEqual(code, 0)
+  assert.match(proc.output(), /JWT_SECRET_ARN \(or JWT_SECRET\) is required/)
+})
+
+test('Lambda (AWS_LAMBDA_HTTP_ENDPOINT set, no APP_ENV) means production mode', async () => {
+  const proc = run({ AWS_LAMBDA_HTTP_ENDPOINT: '127.0.0.1:1', CORS_ALLOWED_ORIGINS: '', JWT_SECRET_ARN: '' })
+  await proc.exited
+  assert.match(proc.output(), /Invalid production configuration/)
+})
