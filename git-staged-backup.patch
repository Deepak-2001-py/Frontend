+      assert.deepEqual(new Set(pr.todo.map((t) => t.title)), new Set(['Not yet'])) // graded-but-unpublished work isn't shown yet
+      await call('t@x.edu', 'acceptFlagged', { evaluation_id: 'S2-2' })
