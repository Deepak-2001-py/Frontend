+  const t = table(config.tables.grading)
+  for (const [q, mm] of [
+    [1, 5],
+    [2, 5],
+  ]) {
+    const item = {
+      evaluation_id: `${student}-${q}${sfx}`,
+      student_id: student,
+      assignment_id: a.assignment_id,
+      qp_id: a.qp_id,
+      type: 'detail',
+      question_number: q,
+      question: `Question ${q}`,
+      max_marks: mm,
+      student_answer: 'ans',
+      timestamp: Math.floor(Date.now() / 1000),
+    }
+    if (corrected) item.status = 'corrected'
+    if (graded) item.marks = 4
+    if (confidence !== undefined && q === 2) item.confidence = confidence
+    await t.put(item)
+  }
+  if (graded) {
+    await t.put({
+      evaluation_id: `${student}-sum${sfx}`,
+      student_id: student,
+      assignment_id: a.assignment_id,
+      qp_id: a.qp_id,
+      type: 'summary',
+      total_marks: 8,
+    })
+  }
