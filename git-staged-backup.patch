diff --git a/backend/src/services/workflow/insights.js b/backend/src/services/workflow/insights.js
new file mode 100644
index 0000000..7d69bb8
--- /dev/null
+++ b/backend/src/services/workflow/insights.js
@@ -0,0 +1,257 @@
+// Teacher: grading queue, students, analytics and settings (wireframes §02, §11).
+import { badRequest } from '../../lib/errors.js'
+import { isoDate, mean, num, pyRound, pyStr, sortBy, truthy } from '../../lib/py.js'
+import { setGradingSettings } from '../../repositories/users.repository.js'
+import {
+  AT_RISK_PERCENT,
+  DEFAULT_SETTINGS,
+  PERSONAS,
+  RANK,
+  enrolledStudents,
+  isFlagged,
+  marksTotal,
+  myAssignments,
+  questions,
+  rank,
+  requireRole,
+  submissions,
+  userSettings,
+  usersById,
+} from './context.js'
+
+const letter = (p) => (p >= 90 ? 'A' : p >= 80 ? 'B' : p >= 70 ? 'C' : p >= 60 ? 'D' : 'F')
+const isSubmitted = (s) => rank(s.status) >= RANK.answer_uploaded
+
+/** Submissions, parsed questions and per-student percent for one assignment. */
+async function stats(item, users) {
+  const { subs, byStudent } = await submissions(item, users)
+  const qs = await questions(item, byStudent)
+  const maxMarks = marksTotal(qs) || num(item.total_marks)
+  const percents = new Map()
+  if (maxMarks > 0) {
+    for (const [sid, entry] of byStudent) {
+      if (entry.summary !== null) percents.set(sid, Math.min(100, (num(entry.summary.total_marks) / maxMarks) * 100))
+    }
+  }
+  return { subs, byStudent, maxMarks, percents }
+}
+
+const QUEUE_ORDER = { review: 0, ready: 1, grading: 2, collecting: 3, setup: 4, published: 5 }
+
+/** §02 "batches waiting to review": every assignment with where it is in grading. */
+export async function getGradingQueue(body, caller) {
+  requireRole(caller, 'teacher', 'admin')
+  const items = await myAssignments(caller)
+  const users = items.length ? await usersById() : new Map()
+  const out = []
+  for (const item of items) {
+    const st = await stats(item, users)
+    const submitted = st.subs.filter(isSubmitted)
+    const graded = submitted.filter((s) => rank(s.status) >= RANK.ai_graded)
+    const gradingCount = st.subs.filter((s) => s.status === 'grading_triggered' || s.status === 'corrected').length
+    let flagged = 0
+    for (const e of st.byStudent.values()) if (e.summary !== null) flagged += e.details.filter(isFlagged).length
+    let state
+    if (item.qp_status !== 'rubric_reviewed' && !(graded.length || gradingCount)) state = 'setup'
+    else if (item.grades_status === 'published' && !flagged && !gradingCount) state = 'published'
+    else if (flagged) state = 'review'
+    else if (gradingCount) state = 'grading'
+    else if (graded.length) state = 'ready'
+    else state = 'collecting'
+    out.push({
+      assignment_id: item.assignment_id,
+      qp_id: item.qp_id,
+      title: item.title ?? null,
+      class_name: item.class_name ?? null,
+      due_at: item.due_at ?? null,
+      state,
+      papers: submitted.length,
+      graded: graded.length,
+      grading: gradingCount,
+      flagged,
+    })
+  }
+  const queue = sortBy(out, (r) => [QUEUE_ORDER[r.state], -r.flagged, r.due_at || '9'])
+  return { queue, waiting: queue.filter((r) => r.state === 'review' || r.state === 'ready').length }
+}
+
+/** §02 Students: everyone in the teacher's classes with how they're doing. */
+export async function listStudents(body, caller) {
+  requireRole(caller, 'teacher', 'admin')
+  const items = sortBy(await myAssignments(caller), (a) => a.created_at ?? '')
+  const users = items.length ? await usersById() : new Map()
+  const students = new Map()
+  const classes = new Set()
+  for (const item of items) {
+    const st = await stats(item, users)
+    classes.add(item.class_name)
+    for (const s of st.subs) {
+      const sid = s.student_id
+      if (!students.has(sid)) {
+        students.set(sid, {
+          student_id: sid,
+          student_name: s.student_name,
+          email: users.get(sid)?.email ?? null,
+          classes: new Set(),
+          assigned: 0,
+          submitted: 0,
+          late: 0,
+          pcts: [],
+          last_submitted_at: null,
+          latest: null,
+        })
+      }
+      const rec = students.get(sid)
+      rec.classes.add(item.class_name)
+      rec.assigned += 1
+      if (isSubmitted(s)) {
+        rec.submitted += 1
+        rec.late += s.late ? 1 : 0
+        const at = s.submitted_at
+        if (at && (rec.last_submitted_at === null || at >= rec.last_submitted_at)) {
+          rec.last_submitted_at = at
+          rec.latest = { assignment_id: item.assignment_id, qp_id: item.qp_id }
+        }
+      }
+      if (st.percents.has(sid)) rec.pcts.push(st.percents.get(sid))
+    }
+  }
+  const out = [...students.values()].map(({ pcts, classes: cls, ...rec }) => {
+    const average = mean(pcts)
+    return {
+      ...rec,
+      classes: sortBy([...cls].filter(truthy), (c) => c),
+      average,
+      at_risk: average !== null && average < AT_RISK_PERCENT,
+    }
+  })
+  return {
+    students: sortBy(out, (r) => (r.student_name || r.student_id).toLowerCase()),
+    classes: sortBy([...classes].filter(truthy), (c) => c),
+  }
+}
+
+const DAY_LABELS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat']
+
+/** §11 class analytics across assignments (optionally one class). */
+export async function getTeacherAnalytics(body, caller) {
+  requireRole(caller, 'teacher', 'admin')
+  const everything = await myAssignments(caller)
+  const classFilter = truthy(body.class_name) ? body.class_name : null
+  const items = everything.filter((a) => !classFilter || a.class_name === classFilter)
+  const users = items.length ? await usersById() : new Map()
+
+  const today = new Date().toISOString().slice(0, 10)
+  const days = Array.from({ length: 7 }, (_, i) => new Date(Date.parse(`${today}T00:00:00Z`) - (6 - i) * 86400000))
+  const weekly = new Map(days.map((d) => [d.toISOString().slice(0, 10), 0]))
+  const dist = { A: 0, B: 0, C: 0, D: 0, F: 0 }
+  const rows = []
+  const allPcts = []
+  const risk = new Set()
+  const hardestByKey = new Map()
+  const upcoming = []
+  let submittedTotal = 0
+  let enrolledTotal = 0
+
+  for (const item of items) {
+    const st = await stats(item, users)
+    for (const [sid, p] of st.percents) {
+      dist[letter(p)] += 1
+      allPcts.push(p)
+      if (p < AT_RISK_PERCENT) risk.add(sid)
+    }
+    const submitted = st.subs.filter(isSubmitted)
+    for (const s of submitted) {
+      const d = isoDate(s.submitted_at)
+      if (d && weekly.has(d)) weekly.set(d, weekly.get(d) + 1)
+    }
+    const enrolled = enrolledStudents(item, users).length || st.subs.length
+    submittedTotal += submitted.length
+    enrolledTotal += enrolled
+    const pcts = [...st.percents.values()]
+    rows.push({
+      assignment_id: item.assignment_id,
+      qp_id: item.qp_id,
+      title: item.title ?? null,
+      class_name: item.class_name ?? null,
+      enrolled,
+      submitted: submitted.length,
+      graded: pcts.length,
+      average: mean(pcts),
+      at_risk: pcts.filter((p) => p < AT_RISK_PERCENT).length,
+      grades_status: item.grades_status ?? null,
+    })
+    for (const entry of st.byStudent.values()) {
+      if (entry.summary === null) continue
+      for (const r of entry.details) {
+        const max = num(r.max_marks)
+        if (max > 0 && r.marks !== undefined && r.marks !== null) {
+          const key = JSON.stringify([item.assignment_id, pyStr(r.question_number), r.subpart || ''])
+          if (!hardestByKey.has(key)) {
+            hardestByKey.set(key, {
+              assignment_id: item.assignment_id,
+              title: item.title ?? null,
+              label: `Q${pyStr(r.question_number ?? null)}${r.subpart || ''}`,
+              got: 0,
+              max: 0,
+            })
+          }
+          const q = hardestByKey.get(key)
+          q.got += num(r.marks)
+          q.max += max
+        }
+      }
+    }
+    if (truthy(item.due_at) && pyStr(item.due_at).slice(0, 10) >= today && item.grades_status !== 'published') {
+      upcoming.push({ assignment_id: item.assignment_id, title: item.title ?? null, class_name: item.class_name ?? null, due_at: item.due_at })
+    }
+  }
+
+  const hardest = sortBy(
+    [...hardestByKey.values()].filter((q) => q.max > 0).map(({ got, max, ...q }) => ({ ...q, average: (got / max) * 100 })),
+    (q) => q.average,
+  ).slice(0, 5)
+  let insight = null
+  if (hardest.length && hardest[0].average < 100) {
+    const h = hardest[0]
+    insight = `${h.label} in "${pyStr(h.title)}" cost the most marks (${pyRound(h.average)}% average) — consider a recap before the next assessment.`
+  }
+  return {
+    classes: sortBy([...new Set(everything.map((a) => a.class_name).filter(truthy))], (c) => c),
+    class_name: classFilter,
+    totals: {
+      assignments: items.length,
+      enrolled: enrolledTotal,
+      submitted: submittedTotal,
+      submission_rate: enrolledTotal ? (submittedTotal / enrolledTotal) * 100 : null,
+      graded: allPcts.length,
+      average: mean(allPcts),
+      at_risk: risk.size,
+    },
+    distribution: dist,
+    weekly: [...weekly.entries()].map(([date, count]) => ({ date, label: DAY_LABELS[new Date(`${date}T00:00:00Z`).getUTCDay()], count })),
+    assignments: sortBy(rows, (r) => r.title || ''),
+    hardest,
+    insight,
+    upcoming: sortBy(upcoming, (u) => pyStr(u.due_at)).slice(0, 5),
+  }
+}
+
+export async function getTeacherSettings(body, caller) {
+  requireRole(caller, 'teacher', 'admin')
+  return { settings: userSettings(caller.user) }
+}
+
+export async function updateTeacherSettings(body, caller) {
+  requireRole(caller, 'teacher', 'admin')
+  const incoming = body.settings
+  if (!incoming || typeof incoming !== 'object' || Array.isArray(incoming)) throw badRequest('settings must be an object.')
+  const merged = userSettings(caller.user)
+  for (const key of Object.keys(DEFAULT_SETTINGS)) if (Object.hasOwn(incoming, key)) merged[key] = incoming[key]
+  if (!PERSONAS.includes(merged.default_persona)) throw badRequest(`default_persona must be one of ${PERSONAS.join(', ')}.`)
+  for (const key of ['partial_credit', 'notify_submissions', 'notify_flagged']) {
+    if (typeof merged[key] !== 'boolean') throw badRequest(`${key} must be true or false.`)
+  }
+  await setGradingSettings(caller.email, merged)
+  return { settings: merged }
+}
diff --git a/backend/src/services/workflow/student.js b/backend/src/services/workflow/student.js
new file mode 100644
index 0000000..e1b5294
--- /dev/null
+++ b/backend/src/services/workflow/student.js
@@ -0,0 +1,162 @@
+// Student: assignment inbox, re-check requests (§14) and progress (§03, §12).
+import { badRequest, conflict } from '../../lib/errors.js'
+import { daysBetween, isoDate, mean, num, pyRound, pyStr, sortBy, trunc, truthy } from '../../lib/py.js'
+import * as grading from '../../repositories/grading.repository.js'
+import * as wf from '../../repositories/workflow.repository.js'
+import {
+  RANK,
+  derivedStatus,
+  firstRowTime,
+  iso,
+  mergeStatus,
+  now,
+  rank,
+  required,
+  requireRole,
+  studentDetails,
+  visibleAssignments,
+} from './context.js'
+
+async function studentEntry(studentId, assignment) {
+  const details = await studentDetails(studentId, assignment)
+  const summaries = await grading.studentRows(studentId, { assignmentId: assignment.assignment_id, type: 'summary' })
+  const sub = (await wf.getSubmission(assignment.assignment_id, studentId)) ?? {}
+  const entry = { summary: summaries[0] ?? null, details }
+  return { entry, sub, status: mergeStatus(derivedStatus(entry), sub.status) }
+}
+
+export async function listStudentAssignments(body, caller) {
+  requireRole(caller, 'student')
+  const published = await visibleAssignments(caller)
+  const out = []
+  for (const a of sortBy(published, (x) => x.due_at || x.created_at || '')) {
+    const { entry, status: merged } = await studentEntry(caller.user_id, a)
+    // Students only ever see published grades; teacher-side states read as "grading".
+    const status = ['ai_graded', 'queued_for_review', 'teacher_reviewed'].includes(merged) ? 'grading_triggered' : merged
+    const view = {
+      assignment_id: a.assignment_id,
+      qp_id: a.qp_id,
+      title: a.title,
+      class_name: a.class_name,
+      due_at: a.due_at,
+      question_count: a.question_count,
+      total_marks: a.total_marks,
+      submission_status: status,
+    }
+    if (entry.summary !== null && (status === 'published' || status === 'published_revised')) {
+      view.evaluation_id = entry.summary.evaluation_id
+    }
+    out.push(Object.fromEntries(Object.entries(view).filter(([, v]) => v !== undefined && v !== null)))
+  }
+  return { assignments: out }
+}
+
+export async function requestRecheck(body, caller) {
+  requireRole(caller, 'student')
+  const [assignmentId, items] = required(body, 'assignment_id', 'items')
+  if (!Array.isArray(items) || !items.length) throw badRequest('Pick at least one question.')
+  const clean = items.map((raw) => {
+    const i = raw && typeof raw === 'object' ? raw : {}
+    const note = pyStr(truthy(i.note) ? i.note : '').trim()
+    if (i.question_number === undefined || i.question_number === null || i.question_number === '' || !note) {
+      throw badRequest('Each item needs a question_number and a note.')
+    }
+    // (subpart is dropped when empty, as workflow.py's _to_dynamo did.)
+    const item = { question_number: i.question_number, note: trunc(note, 1000) }
+    if (truthy(i.subpart)) item.subpart = i.subpart
+    return item
+  })
+  const sub = await wf.getSubmission(assignmentId, caller.user_id)
+  if (!sub || !['published', 'published_revised'].includes(sub.status)) {
+    throw conflict('You can request a re-check once your grades are published.')
+  }
+  await wf.updateSubmission(assignmentId, caller.user_id, {
+    UpdateExpression: 'SET recheck = :r, recheck_requested_at = :t, recheck_status = :s',
+    ExpressionAttributeValues: { ':r': clean, ':t': now(), ':s': 'open' },
+  })
+  return { ok: true }
+}
+
+/** Grade trend, by-class averages, due soon and a personal insight — published work only. */
+export async function getProgress(body, caller) {
+  requireRole(caller, 'student')
+  const uid = caller.user_id
+  const results = []
+  const todo = []
+  for (const a of await visibleAssignments(caller)) {
+    const { entry, sub, status } = await studentEntry(uid, a)
+    const { details } = entry
+    if ((status === 'published' || status === 'published_revised') && entry.summary !== null) {
+      const max = details.reduce((t, r) => t + num(r.max_marks), 0)
+      if (max <= 0) continue
+      const marks = num(entry.summary.total_marks)
+      const first = firstRowTime(details)
+      const submittedAt = truthy(sub.submitted_at) ? iso(sub.submitted_at) : first !== '' ? iso(first) : null
+      const publishedAt =
+        sub.published_at || (truthy(entry.summary.timestamp) ? iso(entry.summary.timestamp) : (a.created_at ?? null))
+      let early = null
+      let onTime = null
+      if (truthy(a.due_at) && submittedAt) {
+        const due = isoDate(a.due_at)
+        const submitted = isoDate(submittedAt)
+        if (due && submitted) {
+          const gap = daysBetween(due, submitted)
+          early = gap >= 1
+          onTime = gap >= 0
+        }
+      }
+      results.push({
+        assignment_id: a.assignment_id,
+        qp_id: a.qp_id,
+        title: a.title ?? null,
+        class_name: a.class_name ?? null,
+        marks,
+        max,
+        percent: Math.min(100, (marks / max) * 100),
+        date: publishedAt,
+        submitted_at: submittedAt,
+        due_at: a.due_at ?? null,
+        early,
+        on_time: onTime,
+      })
+    } else if (rank(status) < RANK.answer_uploaded) {
+      todo.push({
+        assignment_id: a.assignment_id,
+        qp_id: a.qp_id,
+        title: a.title ?? null,
+        class_name: a.class_name ?? null,
+        due_at: a.due_at ?? null,
+      })
+    }
+  }
+  const sortedResults = sortBy(results, (r) => pyStr(r.date))
+  const sortedTodo = sortBy(todo, (t) => pyStr(t.due_at || '9'))
+
+  const byClass = new Map()
+  for (const r of sortedResults) {
+    const key = r.class_name || 'Other'
+    if (!byClass.has(key)) byClass.set(key, [])
+    byClass.get(key).push(r.percent)
+  }
+  let streak = 0
+  for (const r of [...sortedResults].reverse()) {
+    if (r.on_time === false || r.on_time === null) break
+    streak += 1
+  }
+  const early = sortedResults.filter((r) => r.early).map((r) => r.percent)
+  const late = sortedResults.filter((r) => r.early === false).map((r) => r.percent)
+  let insight = null
+  if (early.length && late.length && mean(early) > mean(late)) {
+    insight = `You score about ${pyRound(mean(early) - mean(late))} points higher when you submit a day or more early. Keep the streak going!`
+  } else if (streak >= 2) {
+    insight = `${streak} on-time submissions in a row — keep the streak going!`
+  }
+  return {
+    results: sortedResults,
+    average: mean(sortedResults.map((r) => r.percent)),
+    by_class: sortBy([...byClass.entries()], ([c]) => c).map(([c, v]) => ({ class_name: c, average: mean(v), count: v.length })),
+    todo: sortedTodo.slice(0, 5),
+    streak,
+    insight,
+  }
+}
