+// Teacher → class announcements; students read the ones for their classes.
+import { randomUUID } from 'node:crypto'
+import { badRequest, forbidden, notFound } from '../../lib/errors.js'
+import { pyStr, sortBy, trunc, truthy } from '../../lib/py.js'
+import * as wf from '../../repositories/workflow.repository.js'
+import { myAssignments, now, required, requireRole, visibleAssignments } from './context.js'
+
+export async function postAnnouncement(body, caller) {
+  requireRole(caller, 'teacher', 'admin')
+  const [className, title, message] = required(body, 'class_name', 'title', 'message')
+  const mine = new Set((await myAssignments(caller)).map((a) => a.class_name))
+  if (caller.role !== 'admin' && !mine.has(className)) {
+    throw badRequest('Create an assignment for that class first, then you can post to it.')
+  }
+  const item = {
+    announcement_id: `N-${randomUUID().replace(/-/g, '').slice(0, 10)}`,
+    class_name: trunc(pyStr(className), 100),
+    title: trunc(pyStr(title).trim(), 150),
+    message: trunc(pyStr(message).trim(), 2000),
+    author_id: caller.user_id,
+    author_name: caller.user.name || 'Teacher',
+    created_at: now(),
+  }
+  if (!item.title || !item.message) throw badRequest('A title and a message are required.')
+  await wf.putAnnouncement(item)
+  return { announcement: item }
+}
+
+export async function listAnnouncements(body, caller) {
+  let items
+  if (caller.role === 'student') {
+    let classes = caller.user.classes
+    if (!truthy(classes)) {
+      const visible = await visibleAssignments(caller)
+      classes = sortBy([...new Set(visible.map((a) => a.class_name).filter(truthy))], (c) => c)
+    }
+    items = classes.length ? await wf.announcementsForClasses(classes) : []
+  } else {
+    requireRole(caller, 'teacher', 'admin')
+    items = caller.role === 'admin' ? await wf.scanAnnouncements() : await wf.announcementsByAuthor(caller.user_id)
+  }
+  return { announcements: sortBy(items, (a) => a.created_at ?? '', { reverse: true }).slice(0, 50) }
+}
+
+export async function deleteAnnouncement(body, caller) {
+  requireRole(caller, 'teacher', 'admin')
+  const [announcementId] = required(body, 'announcement_id')
+  const item = await wf.getAnnouncement(announcementId)
+  if (!item) throw notFound('Announcement not found.')
+  if (caller.role !== 'admin' && item.author_id !== caller.user_id) throw forbidden('You can only delete your own announcements.')
+  await wf.deleteAnnouncement(announcementId)
+  return { ok: true }
+}
diff --git a/backend/src/services/workflow/assignments.js b/backend/src/services/workflow/assignments.js
new file mode 100644
index 0000000..4a9be66
--- /dev/null
+++ b/backend/src/services/workflow/assignments.js
@@ -0,0 +1,212 @@
+// Teacher: create assignment → review parsed questions → choose AI or standard
+// grading → rubric → verify → start grading (wireframe §13).
+import { randomUUID } from 'node:crypto'
+import { triggerGrading } from '../../aws/lambda.js'
+import { badRequest, conflict } from '../../lib/errors.js'
+import { num, pyStr, sortBy, trunc, truthy } from '../../lib/py.js'
+import * as wf from '../../repositories/workflow.repository.js'
+import { enqueueJob } from '../jobs.service.js'
+import {
+  PERSONAS,
+  assignmentView,
+  derivedStatus,
+  enrolledStudents,
+  gradingRows,
+  loadAssignment,
+  marksTotal,
+  myAssignments,
+  now,
+  putSubmissionStatus,
+  questions,
+  required,
+  requireRole,
+  userSettings,
+  usersById,
+} from './context.js'
+
+const shortId = () => randomUUID().replace(/-/g, '').slice(0, 10)
+
+export async function listAssignments(body, caller) {
+  requireRole(caller, 'teacher', 'admin')
+  const items = await myAssignments(caller)
+  const users = items.length ? await usersById() : new Map()
+  const out = []
+  for (const item of sortBy(items, (a) => a.created_at ?? '', { reverse: true })) {
+    const view = await assignmentView(item)
+    const enrolled = enrolledStudents(item, users).length
+    if (enrolled) view.enrolled = enrolled
+    out.push(view)
+  }
+  return { assignments: out }
+}
+
+export async function getAssignment(body, caller) {
+  requireRole(caller, 'teacher', 'admin')
+  const [assignmentId] = required(body, 'assignment_id')
+  const item = await loadAssignment(assignmentId, caller)
+  const view = await assignmentView(item)
+  const enrolled = enrolledStudents(item, await usersById()).length
+  if (enrolled) view.enrolled = enrolled
+  return view
+}
+
+export async function createAssignment(body, caller) {
+  requireRole(caller, 'teacher', 'admin')
+  const [title, className] = required(body, 'title', 'class_name')
+  const assignmentId = `A-${shortId()}`
+  const item = {
+    assignment_id: assignmentId,
+    qp_id: `QP-${shortId()}`,
+    title: trunc(pyStr(title), 200),
+    class_name: trunc(pyStr(className), 100),
+    teacher_id: caller.user_id,
+    qp_status: 'qp_uploaded',
+    content_status: 'published',
+    grades_status: 'not_started',
+    created_at: now(),
+  }
+  if (truthy(body.due_at)) item.due_at = pyStr(body.due_at)
+  await wf.putAssignment(item)
+  return { assignment_id: assignmentId, qp_id: item.qp_id }
+}
+
+export async function getParsedQuestions(body, caller) {
+  requireRole(caller, 'teacher', 'admin')
+  const [assignmentId] = required(body, 'assignment_id')
+  const item = await loadAssignment(assignmentId, caller)
+  const qs = await questions(item)
+  return {
+    qp_status: qs.length ? 'qp_parsed' : (item.qp_status ?? 'qp_uploaded'),
+    questions: qs,
+    paper_total: marksTotal(qs),
+  }
+}
+
+export async function confirmQuestions(body, caller) {
+  requireRole(caller, 'teacher', 'admin')
+  const [assignmentId] = required(body, 'assignment_id')
+  const item = await loadAssignment(assignmentId, caller)
+  const qs = await questions(item)
+  if (!qs.length) throw conflict('No parsed questions yet — they appear once the first answers are processed.')
+  await wf.updateAssignment(assignmentId, {
+    UpdateExpression: 'SET questions_confirmed_at = :t, question_count = :n, total_marks = :m, qp_status = if_not_exists(qp_status, :s)',
+    ExpressionAttributeValues: { ':t': now(), ':n': qs.length, ':m': marksTotal(qs), ':s': 'qp_parsed' },
+  })
+  return { ok: true }
+}
+
+export async function setGradingMethod(body, caller) {
+  requireRole(caller, 'teacher', 'admin')
+  const [assignmentId, method] = required(body, 'assignment_id', 'method')
+  if (method !== 'ai' && method !== 'standard') throw badRequest("method must be 'ai' or 'standard'.")
+  const item = await loadAssignment(assignmentId, caller)
+  const defaults = userSettings(caller.user)
+  const persona = [body.persona, item.persona, defaults.default_persona].find(truthy) ?? defaults.default_persona
+  if (!PERSONAS.includes(persona)) throw badRequest(`persona must be one of ${PERSONAS.join(', ')}.`)
+  const partial = Object.hasOwn(body, 'partial_credit')
+    ? truthy(body.partial_credit)
+    : Object.hasOwn(item, 'partial_credit')
+      ? truthy(item.partial_credit)
+      : defaults.partial_credit
+
+  const changedMethod = item.method !== method
+  let status = item.qp_status ?? 'qp_parsed'
+  let expression = 'SET #m = :m, persona = :p, partial_credit = :pc'
+  const values = { ':m': method, ':p': persona, ':pc': partial }
+  if (changedMethod) {
+    // A new method means a new rubric: AI drafts one in the background,
+    // standard starts from the questions for the teacher to fill in.
+    status = method === 'ai' ? 'rubric_generating' : 'rubric_generated'
+    expression += ', qp_status = :s REMOVE rubric'
+    values[':s'] = status
+  }
+  await wf.updateAssignment(assignmentId, {
+    UpdateExpression: expression,
+    ExpressionAttributeNames: { '#m': 'method' },
+    ExpressionAttributeValues: values,
+  })
+  if (changedMethod && method === 'ai') await enqueueJob({ type: 'draftRubric', assignment_id: assignmentId })
+  return { qp_status: status }
+}
+
+export function defaultRubric(qs) {
+  return qs.map((q) => ({
+    question_number: q.question_number,
+    subpart: q.subpart ?? null,
+    title: trunc(q.question || '', 80),
+    max_marks: num(q.max_marks),
+    criteria: '',
+  }))
+}
+
+export async function getRubric(body, caller) {
+  requireRole(caller, 'teacher', 'admin')
+  const [assignmentId] = required(body, 'assignment_id')
+  const item = await loadAssignment(assignmentId, caller)
+  const status = item.qp_status ?? null
+  if (truthy(item.rubric)) return { qp_status: status, rubric: item.rubric }
+  if (status === 'rubric_generating') return { qp_status: status, rubric: [] }
+  return { qp_status: status, rubric: defaultRubric(await questions(item)) }
+}
+
+export async function approveRubric(body, caller) {
+  requireRole(caller, 'teacher', 'admin')
+  const [assignmentId, rubric] = required(body, 'assignment_id', 'rubric')
+  await loadAssignment(assignmentId, caller)
+  if (!Array.isArray(rubric) || !rubric.length) throw badRequest('rubric must be a non-empty list.')
+  const clean = rubric.map((r) => {
+    if (!r || typeof r !== 'object' || Array.isArray(r) || r.question_number === undefined || r.question_number === null || r.question_number === '') {
+      throw badRequest('Every rubric item needs a question_number.')
+    }
+    const marks = num(r.max_marks, -1)
+    if (!(marks >= 0)) throw badRequest(`Invalid max_marks for Q${pyStr(r.question_number)}.`)
+    // (subpart is dropped when empty, as workflow.py's _to_dynamo did.)
+    const item = {
+      question_number: r.question_number,
+      title: trunc(pyStr(truthy(r.title) ? r.title : ''), 200),
+      max_marks: marks,
+      criteria: trunc(pyStr(truthy(r.criteria) ? r.criteria : ''), 4000),
+    }
+    if (truthy(r.subpart)) item.subpart = r.subpart
+    return item
+  })
+  await wf.updateAssignment(assignmentId, {
+    UpdateExpression: 'SET rubric = :r, qp_status = :s, rubric_reviewed_at = :t, rubric_reviewed_by = :u',
+    ExpressionAttributeValues: { ':r': clean, ':s': 'rubric_reviewed', ':t': now(), ':u': caller.user_id },
+  })
+  return { qp_status: 'rubric_reviewed' }
+}
+
+/** Teacher side of the fan-in gate: every corrected submission is graded now. */
+export async function startGrading(body, caller) {
+  requireRole(caller, 'teacher', 'admin')
+  const [assignmentId] = required(body, 'assignment_id')
+  const item = await loadAssignment(assignmentId, caller)
+  if (item.qp_status !== 'rubric_reviewed') throw conflict('Approve the rubric before grading starts.')
+  const byStudent = await gradingRows(item)
+  let triggered = 0
+  for (const [studentId, entry] of byStudent) {
+    if (derivedStatus(entry) !== 'corrected') continue
+    await putSubmissionStatus(assignmentId, studentId, 'grading_triggered')
+    await triggerGrading({
+      assignment_id: item.assignment_id,
+      qp_id: item.qp_id,
+      student_id: studentId,
+      method: item.method ?? null,
+      persona: item.persona ?? 'balanced',
+      partial_credit: item.partial_credit ?? true,
+      rubric: item.rubric ?? [],
+    })
+    triggered += 1
+  }
+  let expression = 'SET grading_started_at = :t'
+  const values = { ':t': now() }
+  // Re-grading after publish keeps the assignment "published"; students keep
+  // their grades until the teacher publishes again (→ published_revised).
+  if (item.grades_status !== 'published') {
+    expression += ', grades_status = :g'
+    values[':g'] = triggered ? 'teacher_reviewing' : 'ai_graded'
+  }
+  await wf.updateAssignment(assignmentId, { UpdateExpression: expression, ExpressionAttributeValues: values })
+  return { ok: true, triggered }
+}
diff --git a/backend/src/services/workflow/assistant.js b/backend/src/services/workflow/assistant.js
new file mode 100644
index 0000000..c4d9a69
--- /dev/null
+++ b/backend/src/services/workflow/assistant.js
@@ -0,0 +1,179 @@
+// GradeFlow assistant (§04) and AI rubric drafting — Claude on Amazon Bedrock.
+import { askClaude } from '../../aws/bedrock.js'
+import { badRequest } from '../../lib/errors.js'
+import { num, pyStr, sortBy, trunc, truthy } from '../../lib/py.js'
+import * as wf from '../../repositories/workflow.repository.js'
+import { defaultRubric } from './assignments.js'
+import { gradingRows, isFlagged, loadAssignment, myAssignments, questions, requireRole, usersById } from './context.js'
+
+async function gradingContext(assignment, studentId) {
+  let byStudent = await gradingRows(assignment)
+  if (truthy(studentId)) byStudent = new Map([...byStudent].filter(([k]) => k === studentId))
+  const users = await usersById()
+  const lines = [
+    `Assignment: ${pyStr(assignment.title ?? null)} (${pyStr(assignment.class_name ?? null)})`,
+    `Grading method: ${pyStr(assignment.method ?? 'not chosen')}, persona: ${pyStr(assignment.persona ?? 'balanced')}`,
+  ]
+  if (truthy(assignment.rubric)) {
+    lines.push('Rubric:')
+    for (const r of assignment.rubric) {
+      lines.push(`  Q${pyStr(r.question_number)}${r.subpart || ''} (${pyStr(r.max_marks ?? null)} marks): ${r.criteria || r.title || ''}`)
+    }
+  }
+  lines.push('Results:')
+  for (const [sid, entry] of byStudent) {
+    const name = users.get(sid)?.name || sid
+    const total = entry.summary ? pyStr(entry.summary.total_marks ?? null) : 'not graded'
+    lines.push(`- Student ${name} [${sid}]: total ${total}`)
+    for (const r of sortBy(entry.details, (x) => [num(x.question_number), pyStr(x.subpart || '')])) {
+      lines.push(
+        `    Q${pyStr(r.question_number ?? null)}${r.subpart || ''}: ${pyStr(r.marks ?? '?')}/${pyStr(r.max_marks ?? '?')}` +
+          `${isFlagged(r) ? ' (low confidence)' : ''}` +
+          ` | answer: ${String(r.student_answer || '').trim()}` +
+          ` | feedback: ${String(r.feedback || '').trim()}`,
+      )
+    }
+  }
+  return lines.join('\n')
+}
+
+const ASSISTANT_SYSTEM = `You are the GradeFlow assistant inside GradeAnt, an AI grading tool for STEM teachers.
+You help the teacher understand and act on grading results: explain why an answer earned its marks against the rubric, \
+find patterns across the class, identify students who are struggling, and draft feedback or re-teaching notes.
+Ground every claim in the grading data provided below; if the data doesn't contain the answer, say so. \
+Refer to students by the name shown. Keep replies concise and practical; use short lists where they help. \
+You can't change grades yourself — when a change looks warranted, tell the teacher which score to override in the correction workspace.
+
+Grading data:
+`
+
+export async function askAssistant(body, caller) {
+  requireRole(caller, 'teacher', 'admin')
+  const { messages } = body
+  if (!Array.isArray(messages) || !messages.length) throw badRequest('messages is required.')
+  const clean = messages.slice(-20).map((m) => {
+    const role = m?.role
+    const content = m?.content
+    if ((role !== 'user' && role !== 'assistant') || typeof content !== 'string' || !content.trim()) {
+      throw badRequest('Each message needs role user|assistant and text content.')
+    }
+    return { role, content: trunc(content, 4000) }
+  })
+  while (clean.length && clean[0].role !== 'user') clean.shift()
+  if (!clean.length || clean[clean.length - 1].role !== 'user') throw badRequest('The last message must be from the user.')
+
+  let context
+  if (truthy(body.assignment_id)) {
+    const assignment = await loadAssignment(body.assignment_id, caller)
+    context = await gradingContext(assignment, body.student_id)
+  } else {
+    const parts = []
+    for (const a of await myAssignments(caller)) parts.push(await gradingContext(a))
+    context = parts.join('\n\n') || 'No assignments yet.'
+  }
+
+  // Chat should answer quickly, so it uses low effort.
+  const reply = await askClaude({ system: ASSISTANT_SYSTEM + context, messages: clean, effort: 'low' })
+  return {
+    reply: reply ?? "I can't help with that request. Try asking about the grades, rubric or feedback for this assignment.",
+  }
+}
+
+const RUBRIC_SCHEMA = {
+  type: 'object',
+  properties: {
+    items: {
+      type: 'array',
+      items: {
+        type: 'object',
+        properties: {
+          question_number: { type: 'string' },
+          subpart: { type: 'string' },
+          title: { type: 'string' },
+          max_marks: { type: 'number' },
+          criteria: { type: 'string' },
+        },
+        required: ['question_number', 'subpart', 'title', 'max_marks', 'criteria'],
+        additionalProperties: false,
+      },
+    },
+  },
+  required: ['items'],
+  additionalProperties: false,
+}
+
+/** The drafted items from Claude's reply (JSON, possibly wrapped in prose or a code fence), or null. */
+export function parseRubricItems(text) {
+  if (!text) return null
+  const start = text.indexOf('{')
+  const end = text.lastIndexOf('}')
+  if (start < 0 || end <= start) return null
+  try {
+    const items = JSON.parse(text.slice(start, end + 1)).items
+    return Array.isArray(items) ? items.filter((r) => r && typeof r === 'object') : null
+  } catch {
+    return null
+  }
+}
+
+/** Background job: GradeFlow drafts a marking rubric from the reviewed questions. */
+export async function draftRubric(assignmentId) {
+  const item = await wf.getAssignment(assignmentId)
+  if (!item || item.qp_status !== 'rubric_generating') return
+  const qs = await questions(item)
+  const rubric = defaultRubric(qs)
+  if (qs.length) {
+    const listing = qs
+      .map((q) => `Q${pyStr(q.question_number)}${q.subpart || ''} [${num(q.max_marks)} marks]: ${q.question || ''}`)
+      .join('\n')
+    const persona = item.persona ?? 'balanced'
+    const partial =
+      !Object.hasOwn(item, 'partial_credit') || truthy(item.partial_credit)
+        ? 'Award method marks (partial credit) for correct working.'
+        : 'Award marks only for correct final answers.'
+    let text = null
+    try {
+      text = await askClaude({
+        system:
+          'You write marking rubrics for STEM homework. For each question, give a short title and concise criteria ' +
+          'saying exactly what earns the marks (key steps, expected result with units/sign, common errors to penalise). ' +
+          "Keep each question's max_marks exactly as given. Use an empty string for subpart when there is none.",
+        messages: [{ role: 'user', content: `Grading persona: ${pyStr(persona)}. ${partial}\n\nQuestions:\n${listing}` }],
+        effort: 'medium',
+        outputFormat: { type: 'json_schema', schema: RUBRIC_SCHEMA },
+      })
+    } catch (err) {
+      // Don't leave the assignment stuck in "Drafting rubric…": the teacher gets
+      // the question-based rubric to fill in, as with the standard method.
+      console.error(
+        JSON.stringify({ level: 'error', msg: 'rubric drafting failed; using the default rubric', assignmentId, error: err?.name, detail: err?.message }),
+      )
+    }
+    const items = parseRubricItems(text)
+    if (items) {
+      const drafted = new Map(items.map((r) => [JSON.stringify([pyStr(r?.question_number), r?.subpart || '']), r]))
+      for (const r of rubric) {
+        const d = drafted.get(JSON.stringify([pyStr(r.question_number), r.subpart || '']))
+        if (d) {
+          r.title = d.title || r.title
+          r.criteria = d.criteria || ''
+        }
+      }
+    }
+  }
+  try {
+    await wf.updateAssignment(assignmentId, {
+      UpdateExpression: 'SET rubric = :r, qp_status = :s',
+      ConditionExpression: 'qp_status = :generating',
+      // (null subparts are dropped, as workflow.py's _to_dynamo did.)
+      ExpressionAttributeValues: {
+        ':r': rubric.map(({ subpart, ...r }) => (subpart === null || subpart === undefined ? r : { ...r, subpart })),
+        ':s': 'rubric_generated',
+        ':generating': 'rubric_generating',
+      },
+    })
+  } catch (err) {
+    // The teacher switched method (or approved) while the draft was running.
+    if (err?.name !== 'ConditionalCheckFailedException') throw err
+  }
+}
diff --git a/backend/src/services/workflow/context.js b/backend/src/services/workflow/context.js
new file mode 100644
index 0000000..ebce6a1
--- /dev/null
+++ b/backend/src/services/workflow/context.js
@@ -0,0 +1,245 @@
+// Shared data helpers for the assignment workflow (port of workflow.py's
+// "Plumbing" and "Data helpers" sections).
+//
+// A submission's status (wireframe §20 SUBMISSIONS chain) is derived from its
+// assignment_grading rows (answer rows → ocr_done, every row corrected →
+// corrected, a summary row → ai_graded, an unresolved low-confidence row →
+// queued_for_review) and merged with the statuses the workflow records itself
+// (grading_triggered, teacher_reviewed, published, published_revised). The
+// later of the two wins.
+import config from '../../config/index.js'
+import { badRequest, forbidden, notFound } from '../../lib/errors.js'
+import { isoUtc, num, pyMin, pyStr, sortBy, sum, truthy } from '../../lib/py.js'
+import * as grading from '../../repositories/grading.repository.js'
+import { listDirectory } from '../../repositories/users.repository.js'
+import * as wf from '../../repositories/workflow.repository.js'
+
+export const SUBMISSION_CHAIN = [
+  'upload_requested',
+  'answer_uploaded',
+  'ocr_done',
+  'corrected',
+  'grading_triggered',
+  'ai_graded',
+  'queued_for_review',
+  'teacher_reviewed',
+  'published',
+  'published_revised',
+]
+export const RANK = Object.fromEntries(SUBMISSION_CHAIN.map((s, i) => [s, i]))
+export const rank = (status) => (Object.hasOwn(RANK, status) ? RANK[status] : 0)
+export const PERSONAS = ['balanced', 'strict', 'lenient']
+export const AT_RISK_PERCENT = 50
+export const DEFAULT_SETTINGS = { default_persona: 'balanced', partial_credit: true, notify_submissions: true, notify_flagged: true }
+
+export const now = () => isoUtc()
+
+/** _require: the caller must have one of these roles. */
+export function requireRole(caller, ...roles) {
+  if (!roles.includes(caller.role)) throw forbidden("Your role can't do that.")
+}
+
+/** _required: values of fields that must not be missing/null/empty-string. */
+export function required(body, ...fields) {
+  const missing = fields.filter((f) => body[f] === undefined || body[f] === null || body[f] === '')
+  if (missing.length) throw badRequest(`Missing required field(s): ${missing.join(', ')}`)
+  return fields.map((f) => body[f])
+}
+
+/** Assignments the caller manages (all of them for an admin). */
+export const myAssignments = (caller) =>
+  caller.role === 'admin' ? wf.scanAssignments() : wf.assignmentsByTeacher(caller.user_id)
+
+/** Published assignments a student can see (their `classes`, or all if none are recorded). */
+export async function visibleAssignments(caller) {
+  const classes = caller.user.classes
+  const published = await wf.publishedAssignments()
+  return truthy(classes) ? published.filter((a) => classes.includes(a.class_name)) : published
+}
+
+export async function loadAssignment(assignmentId, caller) {
+  const item = await wf.getAssignment(assignmentId)
+  if (!item) throw notFound('Assignment not found.')
+  if (caller && caller.role === 'teacher' && item.teacher_id !== caller.user_id) {
+    throw forbidden('This assignment belongs to a different teacher.')
+  }
+  return item
+}
+
+export const studentDetails = (studentId, assignment) =>
+  grading.studentRows(studentId, { assignmentId: assignment.assignment_id, qpId: assignment.qp_id, type: 'notSummary' })
+
+/** Every assignment_grading row for this assignment, grouped by student: Map<student_id, {summary, details}>. */
+export async function gradingRows(assignment, users) {
+  const rows = await grading.assignmentRows(assignment.assignment_id, assignment.qp_id)
+  if (rows !== null) {
+    const byStudent = new Map()
+    for (const r of rows) {
+      if (!byStudent.has(r.student_id)) byStudent.set(r.student_id, { summary: null, details: [] })
+      const entry = byStudent.get(r.student_id)
+      if (r.type === 'summary') entry.summary = r
+      else entry.details.push(r)
+    }
+    return byStudent
+  }
+
+  // No assignment_id index: find candidate students (graded, recorded by the
+  // workflow, or enrolled via Users.classes) and read their rows.
+  const summaries = await grading.summaryRows(assignment.assignment_id, assignment.qp_id)
+  const candidates = new Set(summaries.map((s) => s.student_id))
+  for (const s of await wf.submissionsForAssignment(assignment.assignment_id)) candidates.add(s.student_id)
+  for (const u of enrolledStudents(assignment, users ?? (await usersById()))) candidates.add(u.user_id)
+  const byStudent = new Map()
+  for (const studentId of candidates) {
+    const details = await studentDetails(studentId, assignment)
+    const summary = summaries.find((s) => s.student_id === studentId) ?? null
+    if (details.length || summary !== null) byStudent.set(studentId, { summary, details })
+  }
+  return byStudent
+}
+
+export function isFlagged(row) {
+  const conf = row.confidence
+  return conf !== undefined && conf !== null && num(conf, 1) < config.grading.flagConfidence && !truthy(row.flag_resolved_at)
+}
+
+export function derivedStatus(entry) {
+  const { details, summary } = entry
+  if (summary !== null) return details.some(isFlagged) ? 'queued_for_review' : 'ai_graded'
+  if (details.length) return details.every((r) => r.status === 'corrected') ? 'corrected' : 'ocr_done'
+  return null
+}
+
+export function mergeStatus(derived, stored) {
+  const candidates = [derived, stored].filter((s) => typeof s === 'string' && Object.hasOwn(RANK, s))
+  if (!candidates.length) return 'upload_requested'
+  const best = candidates.reduce((a, b) => (RANK[b] > RANK[a] ? b : a))
+  // A paper that's flagged again after the teacher reviewed it goes back to the queue.
+  if (derived === 'queued_for_review' && ['teacher_reviewed', 'grading_triggered', 'ai_graded'].includes(stored)) {
+    return 'queued_for_review'
+  }
+  return best
+}
+
+/** Map<user_id, user> for everyone in the Users table. */
+export async function usersById() {
+  const users = await listDirectory()
+  return new Map(users.filter((u) => truthy(u.user_id)).map((u) => [u.user_id, u]))
+}
+
+/** Students whose Users.classes lists this assignment's class. */
+export function enrolledStudents(assignment, users) {
+  const cls = assignment.class_name
+  return [...users.values()].filter(
+    (u) => u.userRole === 'student' && truthy(cls) && (Array.isArray(u.classes) ? u.classes : []).includes(cls),
+  )
+}
+
+/** One canonical copy of each parsed question (question text is denormalised onto every student's rows). */
+export async function questions(assignment, byStudent) {
+  const rows = byStudent ?? (await gradingRows(assignment))
+  const out = new Map()
+  for (const entry of rows.values()) {
+    for (const r of entry.details) {
+      const key = JSON.stringify([pyStr(r.question_number), r.subpart || ''])
+      if (!out.has(key)) {
+        out.set(key, {
+          question_number: r.question_number ?? null,
+          subpart: r.subpart ?? null,
+          question: r.question ?? null,
+          max_marks: r.max_marks ?? null,
+          ocr_confidence: r.question_confidence ?? null,
+          question_reviewed: truthy(r.question_reviewed_at),
+        })
+      }
+    }
+  }
+  return sortBy([...out.values()], (q) => [num(q.question_number, 0), pyStr(q.subpart || '')])
+}
+
+export const marksTotal = (qs) => sum(qs.map((q) => num(q.max_marks)))
+
+export async function assignmentView(item, byStudent) {
+  const rows = byStudent ?? (await gradingRows(item))
+  const qs = await questions(item, rows)
+  let qpStatus = item.qp_status ?? 'qp_uploaded'
+  if (qs.length && ['upload_requested', 'qp_uploaded'].includes(qpStatus)) qpStatus = 'qp_parsed'
+  let submitted = 0
+  for (const entry of rows.values()) if (entry.details.length || entry.summary !== null) submitted += 1
+  const view = Object.fromEntries(Object.entries(item).filter(([k]) => k !== 'rubric' && k !== 'teacher_id'))
+  return {
+    ...view,
+    qp_status: qpStatus,
+    question_count: qs.length || (item.question_count ?? null),
+    total_marks: marksTotal(qs) || (item.total_marks ?? null),
+    submitted,
+  }
+}
+
+/** assignment_grading timestamps are epoch seconds/ms; workflow ones are ISO strings. */
+export function iso(value) {
+  if (typeof value === 'number' || (typeof value === 'string' && /^\d+$/.test(value))) {
+    const n = Number(value)
+    return isoUtc(new Date(n > 1e12 ? n : n * 1000))
+  }
+  return pyStr(value)
+}
+
+/** Earliest row timestamp, or '' (min over timestamp/created_at, like workflow.py). */
+export const firstRowTime = (rows) => pyMin(rows.map((r) => r.timestamp || r.created_at || ''), '')
+
+/** Roster rows for one assignment, plus the grading rows and users they were built from. */
+export async function submissions(item, users) {
+  const people = users ?? (await usersById())
+  const byStudent = await gradingRows(item, people)
+  const stored = new Map((await wf.submissionsForAssignment(item.assignment_id)).map((s) => [s.student_id, s]))
+  for (const u of enrolledStudents(item, people)) {
+    if (!byStudent.has(u.user_id)) byStudent.set(u.user_id, { summary: null, details: [] })
+  }
+  const due = item.due_at
+  const out = []
+  for (const [studentId, entry] of byStudent) {
+    const sub = stored.get(studentId) ?? {}
+    const status = mergeStatus(derivedStatus(entry), sub.status)
+    const rows = entry.details
+    const submittedAt = sub.submitted_at || firstRowTime(rows) || null
+    const row = {
+      student_id: studentId,
+      student_name: people.get(studentId)?.name ?? null,
+      status,
+      pages: sub.pages ?? null,
+    }
+    if (truthy(submittedAt)) {
+      row.submitted_at = iso(submittedAt)
+      if (truthy(due) && row.submitted_at.slice(0, 10) > pyStr(due).slice(0, 10)) row.late = true
+    }
+    if (entry.summary !== null) {
+      row.evaluation_id = entry.summary.evaluation_id ?? null
+      row.total_marks = entry.summary.total_marks ?? null
+    }
+    if (sub.recheck_status === 'open') row.recheck = sub.recheck ?? null
+    const confs = rows.filter((r) => r.confidence !== undefined && r.confidence !== null).map((r) => num(r.confidence))
+    if (confs.length) row.confidence = Math.min(...confs)
+    out.push(row)
+  }
+  return { subs: sortBy(out, (r) => (r.student_name || r.student_id).toLowerCase()), byStudent, users: people }
+}
+
+export async function putSubmissionStatus(assignmentId, studentId, status, extra = {}) {
+  let expression = 'SET #s = :s, updated_at = :t'
+  const values = { ':s': status, ':t': now() }
+  const names = { '#s': 'status' }
+  Object.entries(extra).forEach(([k, v], i) => {
+    names[`#x${i}`] = k
+    values[`:x${i}`] = v
+    expression += `, #x${i} = :x${i}`
+  })
+  await wf.updateSubmission(assignmentId, studentId, {
+    UpdateExpression: expression,
+    ExpressionAttributeNames: names,
+    ExpressionAttributeValues: values,
+  })
+}
+
+export const userSettings = (user) => ({ ...DEFAULT_SETTINGS, ...(truthy(user.gradeant_settings) ? user.gradeant_settings : {}) })
+
diff --git a/backend/src/services/workflow/grading.js b/backend/src/services/workflow/grading.js
new file mode 100644
index 0000000..723b091
--- /dev/null
+++ b/backend/src/services/workflow/grading.js
@@ -0,0 +1,136 @@
+// Teacher: grading run, spot-check, publish, roster and reminders (wireframes §15, §19).
+import { sendEmail } from '../../aws/ses.js'
+import { publishNotification } from '../../aws/sns.js'
+import config from '../../config/index.js'
+import { conflict, forbidden, notFound } from '../../lib/errors.js'
+import { num, pyStr, sortBy, trunc, truthy } from '../../lib/py.js'
+import * as grading from '../../repositories/grading.repository.js'
+import * as wf from '../../repositories/workflow.repository.js'
+import {
+  enrolledStudents,
+  gradingRows,
+  isFlagged,
+  loadAssignment,
+  now,
+  putSubmissionStatus,
+  required,
+  requireRole,
+  submissions,
+  usersById,
+} from './context.js'
+
+export async function getGradingRun(body, caller) {
+  requireRole(caller, 'teacher', 'admin')
+  const [assignmentId] = required(body, 'assignment_id')
+  const item = await loadAssignment(assignmentId, caller)
+  const { subs } = await submissions(item)
+  const counts = {}
+  for (const s of subs) counts[s.status] = (counts[s.status] ?? 0) + 1
+  return { total: subs.length, counts, submissions: subs }
+}
+
+export async function listSubmissions(body, caller) {
+  requireRole(caller, 'teacher', 'admin')
+  const [assignmentId] = required(body, 'assignment_id')
+  const item = await loadAssignment(assignmentId, caller)
+  const { subs, users } = await submissions(item)
+  return { submissions: subs, enrolled: enrolledStudents(item, users).length || subs.length }
+}
+
+const rubricKey = (questionNumber, subpart) => JSON.stringify([pyStr(questionNumber), subpart || ''])
+
+export async function listFlagged(body, caller) {
+  requireRole(caller, 'teacher', 'admin')
+  const [assignmentId] = required(body, 'assignment_id')
+  const item = await loadAssignment(assignmentId, caller)
+  const users = await usersById()
+  const rubric = new Map((Array.isArray(item.rubric) ? item.rubric : []).map((r) => [rubricKey(r.question_number, r.subpart), r]))
+  const items = []
+  for (const [studentId, entry] of await gradingRows(item)) {
+    if (entry.summary === null) continue
+    for (const r of entry.details) {
+      if (!isFlagged(r)) continue
+      items.push({
+        evaluation_id: r.evaluation_id,
+        student_id: studentId,
+        student_name: users.get(studentId)?.name ?? null,
+        question_number: r.question_number ?? null,
+        subpart: r.subpart ?? null,
+        confidence: num(r.confidence),
+        reference_answer: rubric.get(rubricKey(r.question_number, r.subpart))?.criteria || null,
+        student_answer: r.student_answer ?? null,
+        proposed_marks: num(r.marks),
+        max_marks: num(r.max_marks),
+      })
+    }
+  }
+  return { items: sortBy(items, (f) => f.confidence) }
+}
+
+export async function acceptFlagged(body, caller) {
+  requireRole(caller, 'teacher', 'admin')
+  const [evaluationId] = required(body, 'evaluation_id')
+  const row = await grading.getRow(evaluationId)
+  if (!row || row.type === 'summary') throw notFound('Answer not found.')
+  const assignment = row.assignment_id ? await wf.getAssignment(row.assignment_id) : undefined
+  const owner = assignment?.teacher_id || row.teacher_id
+  if (caller.role === 'teacher' && owner && owner !== caller.user_id) throw forbidden('This answer belongs to a different teacher.')
+  await grading.updateRow(evaluationId, {
+    UpdateExpression: 'SET flag_resolved_at = :t, flag_resolved_by = :u, flag_resolution = :r',
+    ExpressionAttributeValues: { ':t': now(), ':u': caller.user_id, ':r': 'accepted' },
+  })
+  return { ok: true }
+}
+
+export async function publishGrades(body, caller) {
+  requireRole(caller, 'teacher', 'admin')
+  const [assignmentId] = required(body, 'assignment_id')
+  const item = await loadAssignment(assignmentId, caller)
+  const { subs } = await submissions(item)
+  if (subs.some((s) => s.status === 'queued_for_review')) throw conflict('Clear the flagged answers before publishing.')
+  if (subs.some((s) => s.status === 'grading_triggered' || s.status === 'corrected')) throw conflict('Some papers are still grading.')
+  const at = now()
+  const published = []
+  for (const s of subs) {
+    if (s.total_marks === undefined || s.total_marks === null) continue
+    const status = s.status === 'published' || s.status === 'published_revised' ? 'published_revised' : 'published'
+    await putSubmissionStatus(assignmentId, s.student_id, status, { published_at: at })
+    published.push(s.student_id)
+  }
+  if (!published.length) throw conflict('No graded papers to publish yet.')
+  await wf.updateAssignment(assignmentId, {
+    UpdateExpression: 'SET grades_status = :g, published_at = :t',
+    ExpressionAttributeValues: { ':g': 'published', ':t': at },
+  })
+  await publishNotification({
+    subject: trunc(`Grades published: ${item.title ?? assignmentId}`, 100),
+    message: JSON.stringify({ assignment_id: assignmentId, student_ids: published }),
+  })
+  return { notified: published.length }
+}
+
+export async function remindStudent(body, caller) {
+  requireRole(caller, 'teacher', 'admin')
+  const [assignmentId, studentId] = required(body, 'assignment_id', 'student_id')
+  const item = await loadAssignment(assignmentId, caller)
+  const student = (await usersById()).get(studentId)
+  if (!student || student.userRole !== 'student') throw notFound('Student not found.')
+  const sender = config.mail.sesSenderEmail
+  let emailed = false
+  if (sender && truthy(student.email)) {
+    const due = truthy(item.due_at) ? ` It's due ${pyStr(item.due_at).slice(0, 10)}.` : ''
+    await sendEmail({
+      from: sender,
+      to: student.email,
+      subject: `Reminder: ${pyStr(Object.hasOwn(item, 'title') ? item.title : 'assignment')}`,
+      text: `Hi ${student.name || ''},\n\nPlease submit your answers for "${pyStr(item.title ?? null)}" (${pyStr(item.class_name ?? null)}).${due}\n\n— GradeAnt`,
+    })
+    emailed = true
+  }
+  await wf.updateSubmission(assignmentId, studentId, {
+    UpdateExpression: 'SET reminded_at = :t, #s = if_not_exists(#s, :s)',
+    ExpressionAttributeNames: { '#s': 'status' },
+    ExpressionAttributeValues: { ':t': now(), ':s': 'upload_requested' },
+  })
+  return { ok: true, emailed }
+}
