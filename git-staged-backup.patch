+
+const router = Router()
+router.use(jsonBody())
+router.post(
+  '/',
+  handle(async (req) => presignUploads(bodyOf(req), await authenticate(req)), 'Could not prepare the upload.'),
+)
+router.use(errorHandler({ key: 'message' }))
+
+export default router
diff --git a/backend/src/services/admin.service.js b/backend/src/services/admin.service.js
new file mode 100644
index 0000000..684e5fa
--- /dev/null
+++ b/backend/src/services/admin.service.js
@@ -0,0 +1,461 @@
+// /admin — port of admin/lambda_admin.py: the admin console, one resource
+// dispatching on `operation`. Every operation is admin-only except
+// getInviteDetails / completeFirstLogin (reached from an emailed invite link).
+import { randomBytes, randomUUID } from 'node:crypto'
+import { sendEmail } from '../aws/ses.js'
+import config from '../config/index.js'
+import { badRequest, forbidden, isConditionalCheckFailed, notFound, unauthorized } from '../lib/errors.js'
+import {
+  generateTempPassword as makeTempPassword,
+  hashAdminPassword,
+  hashLoginPassword,
+  verifyAdminPassword,
+} from '../lib/passwords.js'
+import { pyRepr, sortBy, truthy } from '../lib/py.js'
+import { makeSessionToken, verifyLoginJwtForAdmin, verifySessionToken } from '../lib/tokens.js'
+import {
+  adminUsers,
+  analytics,
+  auditLogs,
+  content,
+  equalsFilter,
+  invites,
+  resetRequests,
+  setFields,
+  settings,
+  tickets,
+} from '../repositories/admin.repository.js'
+import { getUserByEmail, setTempPassword } from '../repositories/users.repository.js'
+
+// ---- Auth ------------------------------------------------------------------------
+
+/** Claims for the bearer token: a login JWT (3 parts) or an admin session token (2 parts). */
+export async function bearerClaims(authorization) {
+  const header = authorization ?? ''
+  if (!header.toLowerCase().startsWith('bearer ')) throw unauthorized('Missing Authorization: Bearer <token> header.')
+  const token = header.slice(7).trim()
+  if (token.split('.').length === 3) {
+    const payload = await verifyLoginJwtForAdmin(token)
+    const { email, user_id: userId } = payload
+    if (!email || !userId) throw unauthorized('Malformed session token.')
+    const user = await getUserByEmail(email)
+    if (!user || user.user_id !== userId) throw unauthorized('Account no longer exists.')
+    return { sub: userId, role: user.userRole ?? 'student', name: user.name ?? 'Admin', email }
+  }
+  return verifySessionToken(token)
+}
+
+async function requireAdmin(authorization) {
+  const claims = await bearerClaims(authorization)
+  if (claims.role !== 'admin') throw forbidden('This action is admin-only.')
+  return claims
+}
+
+async function writeAuditLog(actor, action, target) {
+  try {
+    await auditLogs.put({ log_id: randomUUID(), timestamp: Date.now() / 1000, actor, action, target })
+  } catch (err) {
+    // Audit logging must never break the admin's action.
+    console.warn(JSON.stringify({ level: 'warn', msg: 'failed to write audit log', action, target, error: err?.message }))
+  }
+}
+
+const str = (v) => (v === undefined || v === null ? '' : String(v))
+
+// ---- Users -----------------------------------------------------------------------
+
+async function listUsers(p) {
+  const search = str(p.search).trim().toLowerCase()
+  const items = await adminUsers.scanAll(equalsFilter({ role: p.role || undefined, status: p.status || undefined }))
+  const matching = search
+    ? items.filter((u) => str(u.name).toLowerCase().includes(search) || str(u.email).toLowerCase().includes(search))
+    : items
+  const users = matching.map((u) => ({
+    id: u.user_id,
+    name: u.name ?? '',
+    email: u.email ?? '',
+    role: u.role ?? 'student',
+    school: u.school ?? '',
+    status: u.status ?? 'active',
+  }))
+  return { users, total: users.length }
+}
+
+async function updateUserStatus(p, claims) {
+  if (!p.userId || !['active', 'suspended', 'invited'].includes(p.status)) throw badRequest('userId and a valid status are required.')
+  await adminUsers.update({ Key: { user_id: p.userId }, ...setFields({ status: p.status }) })
+  await writeAuditLog(claims.sub, `Set user status to ${p.status}`, p.userId)
+  return { success: true }
+}
+
+async function deleteUser(p, claims) {
+  if (!p.userId) throw badRequest('userId is required.')
+  await adminUsers.delete({ user_id: p.userId })
+  await writeAuditLog(claims.sub, 'Deleted user', p.userId)
+  return { success: true }
+}
+
+// ---- Onboarding: invite → first login (wireframe §17) ------------------------------
+
+const escapeHtml = (s) =>
+  String(s).replace(/[&<>"']/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch])
+
+async function sendInviteEmail(email, name, link) {
+  try {
+    await sendEmail({
+      from: config.mail.inviteSenderEmail,
+      to: email,
+      subject: "You're invited to GradeAnt",
+      html:
+        `<p>Hi ${escapeHtml(name)},</p>` +
+        "<p>You've been invited to GradeAnt. Finish setting up your account:</p>" +
+        `<p><a href="${escapeHtml(link)}">${escapeHtml(link)}</a></p>`,
+    })
+  } catch (err) {
+    // The invite record should still succeed even if SES isn't set up yet.
+    console.warn(JSON.stringify({ level: 'warn', msg: 'failed to send invite email', error: err?.message }))
+  }
+}
+
+async function inviteUsers(p, claims) {
+  const invitees = Array.isArray(p.invitees) ? p.invitees : []
+  if (!invitees.length) throw badRequest('At least one invitee is required.')
+  let invited = 0
+  for (const person of invitees) {
+    const email = str(person?.email).trim()
+    if (!email) continue
+    const name = str(person.name || email).trim()
+    const role = person.role || 'student'
+    const className = person.className || ''
+    const userId = randomUUID()
+    await adminUsers.put({ user_id: userId, name, email, role, school: className, status: 'invited' })
+    const token = randomBytes(24).toString('base64url')
+    await invites.put({
+      token,
+      user_id: userId,
+      full_name: name,
+      role,
+      class_name: className,
+      expires_at: Date.now() / 1000 + config.auth.inviteTokenTtlSeconds,
+      consumed: false,
+    })
+    await sendInviteEmail(email, name, `${config.mail.appBaseUrl}/admin/first_login_setup.html?token=${token}`)
+    invited += 1
+  }
+  await writeAuditLog(claims.sub, `Invited ${invited} user(s)`, invitees.map((x) => str(x?.email)).join(', '))
+  return { invited }
+}
+
+async function loadInvite(token) {
+  if (!token) throw badRequest('token is required.')
+  return invites.get({ token: String(token) })
+}
+
+async function getInviteDetails(p) {
+  const invite = await loadInvite(p.token)
+  if (!invite) throw notFound('This invite link is invalid or has already been used.')
+  if (invite.consumed) throw badRequest('This invite has already been used.')
+  if (Number(invite.expires_at ?? 0) < Date.now() / 1000) throw badRequest('This invite link has expired — ask your admin to resend it.')
+  return { fullName: invite.full_name, role: invite.role, className: invite.class_name ?? '' }
+}
+
+async function completeFirstLogin(p) {
+  const { token, password } = p
+  if (!token || !password || Array.from(String(password)).length < 8) {
+    throw badRequest('token and a password of at least 8 characters are required.')
+  }
+  const invite = await invites.get({ token: String(token) })
+  if (!invite || invite.consumed) throw badRequest('This invite link is invalid or has already been used.')
+  if (Number(invite.expires_at ?? 0) < Date.now() / 1000) throw badRequest('This invite link has expired — ask your admin to resend it.')
+
+  await adminUsers.update({
+    Key: { user_id: invite.user_id },
+    ...setFields({ status: 'active', password_hash: await hashAdminPassword(String(password)) }),
+  })
+  await invites.update({ Key: { token: String(token) }, ...setFields({ consumed: true }) })
+  return {
+    token: await makeSessionToken({ sub: invite.user_id, role: invite.role }, config.auth.sessionTokenTtlSeconds),
+    userId: invite.user_id,
+    role: invite.role,
+    fullName: invite.full_name,
+  }
+}
+
+// ---- Password resets (teachers/students can't self-reset, wireframe §07) ------------
+
+async function listResetRequests(p) {
+  const status = p.status || 'pending'
+  const items = await resetRequests.scanAll(equalsFilter({ status }))
+  const requests = sortBy(
+    items.map((r) => ({
+      id: r.request_id,
+      userName: r.user_name ?? '',
+      userEmail: r.user_email ?? '',
+      role: r.role ?? '',
+      requestedAt: Number(r.requested_at ?? 0),
+      status: r.status ?? 'pending',
+    })),
+    (r) => r.requestedAt,
+    { reverse: true },
+  )
+  return { requests, pendingCount: status === 'pending' ? requests.length : null }
+}
+
+async function approveResetRequest(p, claims) {
+  if (!p.requestId) throw badRequest('requestId is required.')
+  await resetRequests.update({ Key: { request_id: p.requestId }, ...setFields({ status: 'approved', approved_by: claims.sub }) })
+  await writeAuditLog(claims.sub, 'Approved password reset request', p.requestId)
+  return { success: true }
+}
+
+async function rejectResetRequest(p, claims) {
+  if (!p.requestId) throw badRequest('requestId is required.')
+  await resetRequests.update({ Key: { request_id: p.requestId }, ...setFields({ status: 'rejected' }) })
+  await writeAuditLog(claims.sub, 'Rejected password reset request', p.requestId)
+  return { success: true }
+}
+
+async function generateTempPassword(p, claims) {
+  if (!p.requestId) throw badRequest('requestId is required.')
+  const request = await resetRequests.get({ request_id: p.requestId })
+  if (!request) throw notFound('Reset request not found.')
+
+  const temp = makeTempPassword()
+  if (request.source === 'login') {
+    // Requests from the login page reset the login account (Users, keyed by email).
+    try {
+      await setTempPassword(request.user_email, request.user_id, await hashLoginPassword(temp))
+    } catch (err) {
+      if (isConditionalCheckFailed(err)) throw notFound('That account no longer exists.')
+      throw err
+    }
+  } else {
+    await adminUsers.update({
+      Key: { user_id: request.user_id },
+      ...setFields({ password_hash: await hashAdminPassword(temp), must_change_password: true }),
+    })
+  }
+  await resetRequests.update({ Key: { request_id: p.requestId }, ...setFields({ status: 'completed' }) })
+  await writeAuditLog(claims.sub, 'Generated temp password', request.user_email ?? request.user_id)
+  return { tempPassword: temp }
+}
+
+// Fixed governance rules from the wireframe's Permission Matrix (§07).
+const PERMISSION_MATRIX = [
+  { label: 'Change own password', admin: 'yes', teacher: 'yes', student: 'yes' },
+  { label: 'Reset own pw without current', admin: 'no', teacher: 'no', student: 'no' },
+  { label: "Reset another user's pw", admin: 'yes', teacher: 'no', student: 'no' },
+  { label: 'Create teacher / student', admin: 'yes', teacher: 'no', student: 'no' },
+  { label: 'Edit username', admin: 'yes', teacher: 'no', student: 'no' },
+  { label: 'Edit own details (limited)', admin: 'yes', teacher: 'self', student: 'self' },
+  { label: 'Delete / activate users', admin: 'yes', teacher: 'no', student: 'no' },
+  { label: 'View audit logs', admin: 'yes', teacher: 'no', student: 'no' },
+]
+
+const getPermissionMatrix = async () => ({ features: PERMISSION_MATRIX })
+
+// ---- Content & blog --------------------------------------------------------------
+
+async function listContent(p) {
+  const filter = p.filter || 'all'
+  const items = await content.scanAll(filter !== 'all' ? equalsFilter({ status: filter }) : {})
+  const posts = items.map((x) => ({
+    id: x.post_id,
+    title: x.title ?? '(untitled)',
+    author: x.author ?? '',
+    dateLabel: x.date_label ?? '',
+    status: x.status ?? 'draft',
+  }))
+  return { posts: sortBy(posts, (x) => x.dateLabel ?? '', { reverse: true }) }
+}
+
+async function updatePostStatus(p, claims) {
+  if (!p.postId || !['draft', 'pending', 'published'].includes(p.status)) throw badRequest('postId and a valid status are required.')
+  await content.update({ Key: { post_id: p.postId }, ...setFields({ status: p.status }) })
+  await writeAuditLog(claims.sub, `Set post status to ${p.status}`, p.postId)
+  return { success: true }
+}
+
+// ---- Analytics (pre-aggregated by a separate scheduled job) -------------------------
+
+const ANALYTICS_FALLBACK = {
+  activeUsers: { value: '0', trend: 'no data yet', direction: 'flat' },
+  papersGraded: { value: '0', trend: 'no data yet', direction: 'flat' },
+  schools: { value: '0', trend: 'no data yet', direction: 'flat' },
+  uptime: { value: '—', trend: 'no data yet', direction: 'flat' },
+  weeklyPapers: [],
+  topSchools: [],
+}
+
+async function getAnalytics(p) {
+  const item = await analytics.get({ metric_key: p.range || '30d' })
+  return item ? JSON.parse(item.data_json) : ANALYTICS_FALLBACK
+}
+
+// ---- Support tickets -------------------------------------------------------------
+
+async function listTickets(p, claims) {
+  const filter = p.filter || 'open'
+  const condition =
+    filter === 'resolved' ? { status: 'resolved' } : filter === 'mine' ? { assignee_id: claims.sub } : { status: 'open' }
+  const items = await tickets.scanAll(equalsFilter(condition))
+  const list = items.map((t) => ({
+    id: t.ticket_id,
+    priority: t.priority ?? 'med',
+    subject: t.subject ?? '',
+    ageLabel: t.age_label ?? '',
+    requester: t.requester_name ?? '',
+    assignee: t.assignee_name ?? '',
+  }))
+  return { tickets: list, openCount: filter === 'open' ? list.length : null }
+}
+
+async function assignTicket(p, claims) {
+  if (!p.ticketId) throw badRequest('ticketId is required.')
+  await tickets.update({ Key: { ticket_id: p.ticketId }, ...setFields({ assignee_id: claims.sub, assignee_name: claims.name ?? 'Admin' }) })
+  await writeAuditLog(claims.sub, 'Self-assigned ticket', p.ticketId)
+  return { success: true }
+}
+
+async function resolveTicket(p, claims) {
+  if (!p.ticketId) throw badRequest('ticketId is required.')
+  await tickets.update({ Key: { ticket_id: p.ticketId }, ...setFields({ status: 'resolved' }) })
+  await writeAuditLog(claims.sub, 'Resolved ticket', p.ticketId)
+  return { success: true }
+}
+
+// ---- Audit logs --------------------------------------------------------------------
+
+async function listAuditLogs(p) {
+  const search = str(p.search).trim().toLowerCase()
+  const category = p.category || ''
+  let entries = (await auditLogs.scanAll()).map((e) => ({
+    timestamp: Number(e.timestamp ?? 0),
+    actor: e.actor ?? '',
+    action: e.action ?? '',
+    target: e.target ?? '',
+  }))
+  if (category) entries = entries.filter((e) => e.action.toLowerCase().includes(String(category).toLowerCase()))
+  if (search) {
+    entries = entries.filter(
+      (e) => e.actor.toLowerCase().includes(search) || e.action.toLowerCase().includes(search) || e.target.toLowerCase().includes(search),
+    )
+  }
+  return { entries: sortBy(entries, (e) => e.timestamp, { reverse: true }).slice(0, 200) }
+}
+
+// ---- System settings -----------------------------------------------------------------
+
+const DEFAULT_SETTINGS = {
+  platformName: 'GradeAnt',
+  supportEmail: 'support@gradeant.io',
+  sessionTimeoutMinutes: 30,
+  maintenanceMode: false,
+  allowSelfSignup: false,
+}
+
+async function getSettings() {
+  const item = await settings.get({ setting_key: 'platform' })
+  if (!item) return DEFAULT_SETTINGS
+  return {
+    platformName: item.platform_name ?? DEFAULT_SETTINGS.platformName,
+    supportEmail: item.support_email ?? DEFAULT_SETTINGS.supportEmail,
+    sessionTimeoutMinutes: Math.trunc(Number(item.session_timeout_minutes ?? DEFAULT_SETTINGS.sessionTimeoutMinutes)),
+    maintenanceMode: truthy(item.maintenance_mode ?? false),
+    allowSelfSignup: truthy(item.allow_self_signup ?? false),
+  }
+}
+
+async function updateSettings(p, claims) {
+  const timeout = Number(p.sessionTimeoutMinutes ?? 30)
+  if (!Number.isFinite(timeout)) throw badRequest('sessionTimeoutMinutes must be a number.')
+  await settings.put({
+    setting_key: 'platform',
+    platform_name: p.platformName ?? DEFAULT_SETTINGS.platformName,
+    support_email: p.supportEmail ?? DEFAULT_SETTINGS.supportEmail,
+    session_timeout_minutes: timeout,
+    maintenance_mode: truthy(p.maintenanceMode ?? false),
+    allow_self_signup: truthy(p.allowSelfSignup ?? false),
+  })
+  await writeAuditLog(claims.sub, 'Updated system settings', 'platform')
+  return { success: true }
+}
+
+// ---- Admin's own profile ---------------------------------------------------------------
+
+async function getProfile(p, claims) {
+  const user = await adminUsers.get({ user_id: claims.sub })
+  if (!user) throw notFound('Admin profile not found.')
+  return {
+    fullName: user.name ?? '',
+    username: user.username ?? '',
+    email: user.email ?? '',
+    phone: user.phone ?? '',
+    adminLevel: user.admin_level ?? 'admin',
+  }
+}
+
+async function updateProfile(p, claims) {
+  await adminUsers.update({
+    Key: { user_id: claims.sub },
+    ...setFields({ name: p.fullName ?? '', username: p.username ?? '', email: p.email ?? '', phone: p.phone ?? '' }),
+  })
+  await writeAuditLog(claims.sub, 'Updated own profile', claims.sub)
+  return { success: true }
+}
+
+async function changeOwnPassword(p, claims) {
+  const { currentPassword, newPassword } = p
+  if (!currentPassword || !newPassword || Array.from(String(newPassword)).length < 8) {
+    throw badRequest('currentPassword and a newPassword of at least 8 characters are required.')
+  }
+  const user = await adminUsers.get({ user_id: claims.sub })
+  if (!user || !(await verifyAdminPassword(String(currentPassword), user.password_hash ?? ''))) {
+    throw badRequest('Current password is incorrect.')
+  }
+  await adminUsers.update({
+    Key: { user_id: claims.sub },
+    ...setFields({ password_hash: await hashAdminPassword(String(newPassword)), must_change_password: false }),
+  })
+  await writeAuditLog(claims.sub, 'Changed own password', claims.sub)
+  return { success: true }
+}
+
+// ---- Dispatch ------------------------------------------------------------------------
+
+// [handler, requiresAuth]
+const OPERATIONS = {
+  listUsers: [listUsers, true],
+  updateUserStatus: [updateUserStatus, true],
+  deleteUser: [deleteUser, true],
+  inviteUsers: [inviteUsers, true],
+  getInviteDetails: [getInviteDetails, false],
+  completeFirstLogin: [completeFirstLogin, false],
+  listResetRequests: [listResetRequests, true],
+  approveResetRequest: [approveResetRequest, true],
+  rejectResetRequest: [rejectResetRequest, true],
+  generateTempPassword: [generateTempPassword, true],
+  getPermissionMatrix: [getPermissionMatrix, true],
+  listContent: [listContent, true],
+  updatePostStatus: [updatePostStatus, true],
+  getAnalytics: [getAnalytics, true],
+  listTickets: [listTickets, true],
+  assignTicket: [assignTicket, true],
+  resolveTicket: [resolveTicket, true],
+  listAuditLogs: [listAuditLogs, true],
+  getSettings: [getSettings, true],
+  updateSettings: [updateSettings, true],
+  getProfile: [getProfile, true],
+  updateProfile: [updateProfile, true],
+  changeOwnPassword: [changeOwnPassword, true],
+}
+
+export async function dispatch(body, authorization) {
+  const operation = body.operation
+  if (!operation || typeof operation !== 'string' || !Object.hasOwn(OPERATIONS, operation)) {
+    throw badRequest(`Unknown or missing operation: ${pyRepr(operation ?? null)}`)
+  }
+  const [handler, requiresAuth] = OPERATIONS[operation]
+  const claims = requiresAuth ? await requireAdmin(authorization) : null
+  return handler(body, claims)
+}
diff --git a/backend/src/services/auth.service.js b/backend/src/services/auth.service.js
new file mode 100644
index 0000000..ff788be
--- /dev/null
+++ b/backend/src/services/auth.service.js
@@ -0,0 +1,186 @@
+// /auth/* — port of lambda_python_files/authetication.py. Same request and
+// response bodies, status codes and messages.
+import { randomUUID } from 'node:crypto'
+import { storage } from '../aws/s3.js'
+import config from '../config/index.js'
+import { HttpError, badRequest, reply, unauthorized } from '../lib/errors.js'
+import { hashLoginPassword, passwordProblem, verifyLoginPassword } from '../lib/passwords.js'
+import { isoNaive } from '../lib/py.js'
+import { decodeLoginToken, issueLoginToken } from '../lib/tokens.js'
+import { pendingResetRequestsFor, resetRequests } from '../repositories/admin.repository.js'
+import { getUserByEmail, putUser, setLastLogin, setPassword, setPhotoKey } from '../repositories/users.repository.js'
+
+const PHOTO_URL_TTL = 3600
+const PHOTO_TYPES = { 'image/jpeg': 'jpg', 'image/png': 'png', 'image/webp': 'webp' }
+
+/** body['field'] with Python's KeyError → 400 "Missing required field: 'field'". */
+function field(obj, name) {
+  if (!obj || typeof obj !== 'object' || !(name in obj)) throw badRequest(`Missing required field: '${name}'`)
+  return obj[name]
+}
+
+async function photoViewUrl(user) {
+  const key = user.photo_key
+  const bucket = config.storage.profilePhotoBucket
+  if (!key || !bucket) return null
+  return storage().presignGet(bucket, key, PHOTO_URL_TTL)
+}
+
+/** The Users item for a valid bearer token, or null. */
+async function authenticatedUser(token) {
+  if (!token) return null
+  const { payload } = await decodeLoginToken(token)
+  if (!payload) return null
+  const item = await getUserByEmail(payload.email)
+  if (!item || item.user_id !== payload.user_id) return null
+  return item
+}
+
+export async function signup(body) {
+  const email = field(body, 'email')
+  const password = field(body, 'password')
+  const name = body.name ?? ''
+  const userRole = body.role ?? ''
+  if (await getUserByEmail(email)) return reply(409, { message: 'User already exists' })
+
+  const userId = randomUUID()
+  const timestamp = isoNaive()
+  await putUser({
+    user_id: userId,
+    email,
+    name,
+    password: await hashLoginPassword(String(password)),
+    userRole,
+    created_at: timestamp,
+    updated_at: timestamp,
+  })
+  return reply(201, {
+    message: 'User created successfully',
+    user_id: userId,
+    userRole,
+    name,
+    email,
+    token: await issueLoginToken(userId, email),
+  })
+}
+
+export async function login(body) {
+  const email = field(body, 'email')
+  const password = field(body, 'password')
+  const userRole = field(body, 'userType')
+  const user = await getUserByEmail(email)
+  if (!user) throw unauthorized('Invalid credentials')
+  if (userRole !== field(user, 'userRole')) throw unauthorized('Invalid credentials')
+  if (!(await verifyLoginPassword(field(user, 'password'), password))) throw unauthorized('Invalid credentials')
+
+  const token = await issueLoginToken(user.user_id, user.email)
+  await setLastLogin(email, isoNaive())
+  return {
+    message: 'Login successful',
+    user_id: user.user_id,
+    userRole: user.userRole,
+    name: field(user, 'name'),
+    email: user.email,
+    must_change_password: Boolean(user.must_change_password),
+    photoUrl: await photoViewUrl(user),
+    token,
+  }
+}
+
+export async function logout(authorization) {
+  if (!authorization || !authorization.startsWith('Bearer ')) throw unauthorized('Invalid authorization header')
+  const token = authorization.split(' ')[1]
+  const { payload } = await decodeLoginToken(token ?? '')
+  if (!payload) throw unauthorized('Invalid or expired token')
+  return { message: 'Logout successful' }
+}
+
+/**
+ * Teachers/students can't reset their own password — this files a request for
+ * an admin. Always answers the same way so it can't reveal which emails exist.
+ */
+export async function forgotPassword(body) {
+  const generic = { message: 'If that account exists, your password reset request has been sent to the administrator.' }
+  const email = String(body.email ?? '').trim()
+  if (!email) throw badRequest('Email is required.')
+  try {
+    const user = await getUserByEmail(email)
+    // Admins reset their own password from their profile page.
+    if (!user || !['student', 'teacher'].includes(user.userRole)) return generic
+    if ((await pendingResetRequestsFor(user.user_id)).length) return generic
+    await resetRequests.put({
+      request_id: randomUUID(),
+      user_id: user.user_id,
+      user_name: user.name ?? '',
+      user_email: user.email,
+      role: user.userRole,
+      requested_at: Math.floor(Date.now() / 1000),
+      status: 'pending',
+      source: 'login',
+    })
+    return generic
+  } catch (err) {
+    console.error(JSON.stringify({ level: 'error', msg: 'forgot password failed', error: err?.message }))
+    throw new HttpError(500, 'Could not submit your request. Please try again.')
+  }
+}
+
+/** Authenticated change; also clears the must-change flag set by an admin-issued temp password. */
+export async function changePassword(token, body) {
+  const user = await authenticatedUser(token)
+  if (!user) throw unauthorized('Invalid or expired token')
+  const current = body.currentPassword || ''
+  const next = body.newPassword || ''
+  if (!(await verifyLoginPassword(user.password, current))) throw badRequest('Current password is incorrect.')
+  const problem = passwordProblem(next)
+  if (problem) throw badRequest(problem)
+  if (next === current) throw badRequest('Choose a password different from your current one.')
+  await setPassword(user.email, await hashLoginPassword(next), isoNaive())
+  return { message: 'Password updated.' }
+}
+
+/** Fresh copy of the account fields the profile page shows. */
+export async function me(token) {
+  const user = await authenticatedUser(token)
+  if (!user) throw unauthorized('Invalid or expired token')
+  return {
+    user_id: user.user_id,
+    name: user.name ?? '',
+    email: user.email,
+    userRole: user.userRole ?? '',
+    status: user.status ?? 'active',
+    must_change_password: Boolean(user.must_change_password),
+    photoUrl: await photoViewUrl(user),
+  }
+}
+
+/** Two steps: action=upload-url returns a presigned PUT, then action=confirm records it. */
+export async function profilePhoto(token, body) {
+  const user = await authenticatedUser(token)
+  if (!user) throw unauthorized('Invalid or expired token')
+  const bucket = config.storage.profilePhotoBucket
+  if (!bucket) throw new HttpError(503, 'Profile photos are not configured.')
+
+  const isPhotoType = Object.hasOwn(PHOTO_TYPES, String(body.contentType))
+  const key = `profile-photos/${user.user_id}.${isPhotoType ? PHOTO_TYPES[body.contentType] : ''}`
+  const store = storage()
+
+  if (body.action === 'upload-url') {
+    if (!isPhotoType) throw badRequest('Use a JPG, PNG or WebP image.')
+    return { uploadUrl: await store.presignPut(bucket, key, body.contentType, 300), key }
+  }
+
+  if (body.action === 'confirm') {
+    // Only accept the key we issued for this user, and only once the object exists.
+    if (!isPhotoType || body.key !== key) throw badRequest('Invalid photo key.')
+    const head = await store.head(bucket, key)
+    if (head.contentLength > 5 * 1024 * 1024) {
+      await store.delete(bucket, key)
+      throw badRequest('Photo must be under 5 MB.')
+    }
+    await setPhotoKey(user.email, key)
+    return { photoUrl: await photoViewUrl({ photo_key: key }) }
+  }
+
+  throw badRequest('Unknown action.')
+}
diff --git a/backend/src/services/correction.service.js b/backend/src/services/correction.service.js
new file mode 100644
index 0000000..9e4b80d
--- /dev/null
+++ b/backend/src/services/correction.service.js
@@ -0,0 +1,247 @@
+// /correctanswer — port of lambda_python_files/correct_questions_answer.py:
+// the post-upload correction workspace.
+//   Student: getAnswersForCorrection / submitAnswerCorrections (OCR'd answer text)
+//   Teacher: getQuestionsForCorrection / submitQuestionCorrections (parsed question
+//            text, fanned out to every student's denormalised copy)
+import { isConditionalCheckFailed, badRequest, forbidden, reply } from '../lib/errors.js'
+import { isoNaive, pyStr, sortBy, truthy } from '../lib/py.js'
+import { getRow, studentRows, summaryRows, updateRow } from '../repositories/grading.repository.js'
+
+const keyStr = (v) => pyStr(truthy(v) ? v : '')
+const isMissing = (v) => v === undefined || v === null
+
+export async function getAnswersForCorrection(body, caller) {
+  const { student_id: studentId, assignment_id: assignmentId, qp_id: qpId } = body
+  if (!truthy(studentId) || !truthy(assignmentId)) throw badRequest('student_id and assignment_id are required')
+  if (caller.role === 'student' && studentId !== caller.user_id) throw forbidden('You can only view your own answers.')
+
+  const items = await studentRows(studentId, {
+    assignmentId,
+    type: 'notSummary',
+    ...(truthy(qpId) ? { qpId } : {}),
+  })
+
+  // A teacher (not admin) may only browse a submission that's unowned or already theirs.
+  if (caller.role === 'teacher') {
+    const owners = new Set(items.map((i) => i.teacher_id).filter(Boolean))
+    if (owners.size && !owners.has(caller.user_id)) {
+      throw forbidden("This student's answers belong to a different teacher's class.")
+    }
+  }
+
+  const answers = items.map((item) => ({
+    evaluation_id: item.evaluation_id ?? null,
+    question_number: item.question_number ?? null,
+    subpart: item.subpart ?? null,
+    question: item.question ?? null,
+    student_answer: item.student_answer ?? null,
+    is_latex: item.is_latex ?? false,
+    max_marks: item.max_marks ?? null,
+    status: item.status ?? null,
+    corrected_by: item.corrected_by ?? null,
+    corrected_at: item.corrected_at ?? null,
+  }))
+  return {
+    student_id: studentId,
+    assignment_id: assignmentId,
+    qp_id: qpId ?? null,
+    answers: sortBy(answers, (a) => [keyStr(a.question_number), keyStr(a.subpart)]),
+  }
+}
+
+/** Student submits corrected answer text; status='corrected' feeds the grading fan-in gate. */
+export async function submitAnswerCorrections(body, caller) {
+  if (caller.role !== 'student') throw forbidden('Only the student who owns this submission can correct it.')
+  const { corrections } = body
+  if (!Array.isArray(corrections) || !corrections.length) throw badRequest('corrections (non-empty array) is required')
+
+  const updated = []
+  const errors = []
+  const now = isoNaive()
+  for (const correction of corrections) {
+    const c = correction && typeof correction === 'object' ? correction : {}
+    const evaluationId = c.evaluation_id
+    const questionNumber = c.question_number
+    const answer = c.corrected_answer
+    const isLatex = truthy(c.is_latex ?? false)
+
+    if (!truthy(evaluationId)) {
+      errors.push('Missing evaluation_id in correction')
+      continue
+    }
+    if (isMissing(questionNumber)) {
+      errors.push(`Missing question_number for evaluation_id ${evaluationId}`)
+      continue
+    }
+    if (isMissing(answer) || pyStr(answer).trim() === '') {
+      errors.push(`corrected_answer is required for evaluation_id ${evaluationId}`)
+      continue
+    }
+    try {
+      // Only the owning student may correct their own answer.
+      const existing = await getRow(evaluationId)
+      if (!existing) {
+        errors.push(`No record found with evaluation_id ${evaluationId}`)
+        continue
+      }
+      if (existing.student_id !== caller.user_id) {
+        errors.push(`evaluation_id ${evaluationId} belongs to a different student.`)
+        continue
+      }
+      await updateRow(evaluationId, {
+        UpdateExpression:
+          'SET student_answer = :sa, is_latex = :il, #st = :status, corrected_by = :cb, corrected_at = :ca, updated_at = :ua',
+        ConditionExpression: '#qn = :qn',
+        ExpressionAttributeNames: { '#st': 'status', '#qn': 'question_number' },
+        ExpressionAttributeValues: {
+          ':sa': answer,
+          ':il': isLatex,
+          ':status': 'corrected',
+          ':cb': caller.user_id,
+          ':ca': now,
+          ':ua': now,
+          ':qn': questionNumber,
+        },
+      })
+      updated.push({ evaluation_id: evaluationId, question_number: questionNumber, updated: true, is_latex: isLatex })
+    } catch (err) {
+      if (isConditionalCheckFailed(err)) errors.push(`No matching question_number ${pyStr(questionNumber)} for evaluation_id ${evaluationId}`)
+      else errors.push(`Failed to correct evaluation_id ${evaluationId}: ${err?.message}`)
+    }
+  }
+
+  const response = {
+    message: errors.length ? 'Correction completed with some errors' : 'Correction completed',
+    updated_items: updated,
+    total_updated: updated.length,
+    success: errors.length === 0,
+  }
+  if (errors.length) response.errors = errors
+  if (!updated.length) {
+    response.message = 'No answers were corrected'
+    return reply(404, response)
+  }
+  return reply(errors.length ? 207 : 200, response)
+}
+
+/** Roster for a question paper — every student's summary row (type-index). */
+const classRoster = (qpId, assignmentId) => summaryRows(assignmentId, qpId)
+
+/** One canonical copy of each question's parsed text, so the teacher reviews it once. */
+export async function getQuestionsForCorrection(body, caller) {
+  if (!['teacher', 'admin'].includes(caller.role)) throw forbidden('Only a teacher or admin can review question text.')
+  const { qp_id: qpId, assignment_id: assignmentId } = body
+  if (!truthy(qpId) || !truthy(assignmentId)) throw badRequest('qp_id and assignment_id are required')
+
+  let roster = await classRoster(qpId, assignmentId)
+  if (caller.role === 'teacher') roster = roster.filter((g) => !g.teacher_id || g.teacher_id === caller.user_id)
+  if (!roster.length) return { qp_id: qpId, assignment_id: assignmentId, questions: [] }
+
+  const byKey = new Map()
+  for (const student of roster) {
+    if (!truthy(student.student_id)) continue
+    const details = await studentRows(student.student_id, { assignmentId, qpId, type: 'notSummary' })
+    for (const item of details) {
+      const key = JSON.stringify([pyStr(item.question_number), item.subpart || ''])
+      if (!byKey.has(key)) {
+        byKey.set(key, {
+          question_number: item.question_number ?? null,
+          subpart: item.subpart ?? null,
+          question: item.question ?? null,
+          is_latex: item.question_is_latex ?? false,
+          max_marks: item.max_marks ?? null,
+          question_reviewed: truthy(item.question_reviewed_at),
+          question_reviewed_by: item.question_reviewed_by ?? null,
+          question_reviewed_at: item.question_reviewed_at ?? null,
+        })
+      }
+    }
+    // One representative student's rows are enough: question text is identical across the class.
+    if (byKey.size) break
+  }
+  const questions = sortBy([...byKey.values()], (q) => [keyStr(q.question_number), keyStr(q.subpart)])
+  return { qp_id: qpId, assignment_id: assignmentId, questions }
+}
+
+/** Teacher corrects question text; each correction fans out to every student's copy. */
+export async function submitQuestionCorrections(body, caller) {
+  if (!['teacher', 'admin'].includes(caller.role)) throw forbidden('Only a teacher or admin can correct question text.')
+  const { qp_id: qpId, assignment_id: assignmentId, corrections } = body
+  if (!truthy(qpId) || !truthy(assignmentId)) throw badRequest('qp_id and assignment_id are required')
+  if (!Array.isArray(corrections) || !corrections.length) throw badRequest('corrections (non-empty array) is required')
+
+  const roster = await classRoster(qpId, assignmentId)
+  const now = isoNaive()
+  const updatedQuestions = []
+  const errors = []
+
+  for (const correction of corrections) {
+    const c = correction && typeof correction === 'object' ? correction : {}
+    const questionNumber = c.question_number
+    const subpart = c.subpart ?? null
+    const text = c.corrected_question
+    const isLatex = truthy(c.is_latex ?? false)
+    if (isMissing(questionNumber)) {
+      errors.push('Missing question_number in correction')
+      continue
+    }
+    if (isMissing(text) || pyStr(text).trim() === '') {
+      errors.push(`corrected_question is required for question_number ${pyStr(questionNumber)}`)
+      continue
+    }
+
+    let recordsUpdated = 0
+    for (const student of roster) {
+      const studentId = student.student_id
+      if (!truthy(studentId)) continue
+      // Rows already owned by a different teacher are skipped, not overwritten.
+      const owner = student.teacher_id
+      if (owner && caller.role !== 'admin' && owner !== caller.user_id) continue
+      try {
+        const details = await studentRows(studentId, { assignmentId, qpId, questionNumber, type: 'notSummary' })
+        for (const item of details) {
+          if (truthy(subpart) && item.subpart !== subpart) continue
+          await updateRow(item.evaluation_id, {
+            UpdateExpression:
+              'SET question = :q, question_is_latex = :il, question_reviewed_by = :rb, question_reviewed_at = :ra, updated_at = :ua',
+            ConditionExpression: '#qn = :qn',
+            ExpressionAttributeNames: { '#qn': 'question_number' },
+            ExpressionAttributeValues: {
+              ':q': text,
+              ':il': isLatex,
+              ':rb': caller.user_id,
+              ':ra': now,
+              ':ua': now,
+              ':qn': questionNumber,
+            },
+          })
+          recordsUpdated += 1
+        }
+      } catch (err) {
+        errors.push(`Failed to update student ${studentId}, question ${pyStr(questionNumber)}: ${err?.message}`)
+      }
+    }
+    updatedQuestions.push({ question_number: questionNumber, subpart, records_updated: recordsUpdated })
+  }
+
+  const total = updatedQuestions.reduce((n, q) => n + q.records_updated, 0)
+  const response = {
+    message: errors.length ? 'Question correction completed with some errors' : 'Question correction completed',
+    updated_questions: updatedQuestions,
+    total_records_updated: total,
+    success: errors.length === 0,
+  }
+  if (errors.length) response.errors = errors
+  if (total === 0) {
+    response.message = 'No question records were updated'
+    return reply(404, response)
+  }
+  return reply(errors.length ? 207 : 200, response)
+}
+
+export const operations = {
+  getAnswersForCorrection,
+  submitAnswerCorrections,
+  getQuestionsForCorrection,
+  submitQuestionCorrections,
+}
diff --git a/backend/src/services/grades.service.js b/backend/src/services/grades.service.js
new file mode 100644
index 0000000..00c72b4
--- /dev/null
+++ b/backend/src/services/grades.service.js
@@ -0,0 +1,61 @@
+// /getgrades — port of lambda_python_files/get_grades.py.
+//   getSingleStudentGrade   a student may only read their own grades
+//   getAllStudentGrades     class roster, teacher/admin only
+//   updateStudentGrade      total marks, teacher/admin only
+// Teacher-to-teacher isolation is best-effort, as before: rows that already
+// name a different owning teacher_id are hidden or refused; ownerless rows are not.
+import { badRequest, forbidden, notFound } from '../lib/errors.js'
+import { truthy } from '../lib/py.js'
+import { studentRows, summaryRows, updateRow } from '../repositories/grading.repository.js'
+
+export async function getSingleStudentGrade(body, caller) {
+  const { student_id: studentId, assignment_id: assignmentId } = body
+  if (!truthy(studentId) || !truthy(assignmentId)) throw badRequest('Missing required parameters: student_id and assignment_id')
+  if (caller.role === 'student' && studentId !== caller.user_id) throw forbidden('You can only view your own grades.')
+
+  // (The field names are swapped relative to their contents, as the frontend expects.)
+  const details = await studentRows(studentId, { assignmentId, type: 'notSummary' })
+  const summary = await studentRows(studentId, { assignmentId, type: 'summary' })
+
+  if (caller.role === 'teacher') {
+    const owners = new Set(summary.map((i) => i.teacher_id).filter(Boolean))
+    if (owners.size && !owners.has(caller.user_id)) {
+      throw forbidden("This student's results belong to a different teacher's class.")
+    }
+  }
+  return { student_id: studentId, assignment_id: assignmentId, details, summary }
+}
+
+export async function getAllStudentGrades(body, caller) {
+  if (!['teacher', 'admin'].includes(caller.role)) throw forbidden('Only a teacher or admin can view a class roster.')
+  const { qp_id: qpId, assignment_id: assignmentId } = body
+  if (!truthy(qpId) || !truthy(assignmentId)) throw badRequest('Missing required parameters: qp_id and assignment_id')
+
+  let grades = await summaryRows(assignmentId, qpId)
+  if (caller.role === 'teacher') grades = grades.filter((g) => !g.teacher_id || g.teacher_id === caller.user_id)
+  return { qp_id: qpId, assignment_id: assignmentId, student_count: grades.length, grades }
+}
+
+export async function updateStudentGrade(body, caller) {
+  if (!['teacher', 'admin'].includes(caller.role)) throw forbidden('Only a teacher or admin can update grades.')
+  const { student_id: studentId, qp_id: qpId, total_marks: totalMarks } = body
+  if (![studentId, qpId, totalMarks].every(truthy)) {
+    throw badRequest('student_id, qp_id, type, and total_marks are required')
+  }
+  const rows = await studentRows(studentId, { type: 'summary' })
+  const item = rows.find((i) => i.qp_id === qpId && i.type === 'summary')
+  // (get_grades.py returned nothing here, which API Gateway turned into a 502.)
+  if (!item) throw notFound('No summary record found for that student and question paper.')
+
+  if (item.teacher_id && caller.role !== 'admin' && item.teacher_id !== caller.user_id) {
+    throw forbidden('This assignment belongs to a different teacher.')
+  }
+  await updateRow(item.evaluation_id, {
+    UpdateExpression: 'SET total_marks = :tm, teacher_id = :tid',
+    ExpressionAttributeValues: { ':tm': totalMarks, ':tid': caller.user_id },
+  })
+  // Same (pre-update) rows the Python handler echoed back.
+  return { message: 'Total marks updated successfully', updatedAttributes: rows }
+}
+
+export const operations = { getSingleStudentGrade, getAllStudentGrades, updateStudentGrade }
diff --git a/backend/src/services/jobs.service.js b/backend/src/services/jobs.service.js
new file mode 100644
index 0000000..3d87880
--- /dev/null
+++ b/backend/src/services/jobs.service.js
@@ -0,0 +1,28 @@
+// Background jobs (currently: AI rubric drafting). workflow.py ran these by
+// invoking its own Lambda asynchronously; a Web Function has no such
+// self-invoke, so:
+//   JOBS_DRIVER=inline  run the job before the request returns (development,
+//                       and production without a queue — set the revision
+//                       timeout to 60 s or more, since it waits for Claude)
+//   JOBS_DRIVER=sqs     send it to JOBS_QUEUE_URL; worker.js (a regular Lambda
+//                       function subscribed to the queue) runs it, with SQS retries
+import { sendJobMessage } from '../aws/sqs.js'
+import config from '../config/index.js'
+
+const HANDLERS = {
+  draftRubric: async (job) => {
+    const { draftRubric } = await import('./workflow/assistant.js')
+    await draftRubric(job.assignment_id)
+  },
+}
+
+export async function enqueueJob(job) {
+  if (!Object.hasOwn(HANDLERS, job.type)) throw new Error(`Unknown job type: ${job.type}`)
+  if (config.drivers.jobs === 'sqs') return sendJobMessage(job)
+  return runJob(job)
+}
+
+export async function runJob(job) {
+  if (!job || !Object.hasOwn(HANDLERS, job.type)) throw new Error(`Unknown job type: ${job?.type}`)
+  await HANDLERS[job.type](job)
+}
diff --git a/backend/src/services/marks.service.js b/backend/src/services/marks.service.js
new file mode 100644
index 0000000..f5f196b
--- /dev/null
+++ b/backend/src/services/marks.service.js
@@ -0,0 +1,173 @@
+// /updatedb — port of lambda_python_files/update_db.py: teacher/admin edits
+// to marks. Every row touched is stamped with teacher_id = caller, and a row
+// already owned by another teacher is refused (admins excepted).
+import { isConditionalCheckFailed, badRequest, forbidden, notFound, reply, HttpError } from '../lib/errors.js'
+import { isoNaive, pyStr, truthy } from '../lib/py.js'
+import { getRow, updateRow } from '../repositories/grading.repository.js'
+
+/** Decimal(str(value)): a finite number, or throws like Python's Decimal would. */
+function decimal(value) {
+  const n = typeof value === 'number' ? value : typeof value === 'string' && value.trim() !== '' ? Number(value) : NaN
+  if (!Number.isFinite(n)) throw Object.assign(new Error(`Invalid number: ${pyStr(value)}`), { name: 'ValueError' })
+  return n
+}
+
+const ownedByOther = (row, caller) => row?.teacher_id && caller.role !== 'admin' && row.teacher_id !== caller.user_id
+
+export async function updateMarks(body, caller) {
+  if (!['teacher', 'admin'].includes(caller.role)) throw forbidden('Only a teacher or admin can update grades.')
+  const summaryRaw = body.summary
+  const details = Array.isArray(body.details) ? body.details : []
+  if (!truthy(summaryRaw) && !details.length) throw badRequest('Either summary or details data is required')
+
+  const updated = []
+  const errors = []
+
+  // Summary: the frontend sends a one-element array; only [0] is applied (as before).
+  // A details-only request skips this step (update_db.py crashed with a 500 there).
+  const summary = Array.isArray(summaryRaw) ? summaryRaw[0] : undefined
+  if (Array.isArray(summaryRaw) ? summaryRaw.length : truthy(summaryRaw)) {
+    const evaluationId = summary?.evaluation_id
+    try {
+      if (!summary || typeof summary !== 'object') throw new Error('summary must be a list of objects')
+      const totalMarks = decimal(summary.total_marks)
+      const existing = truthy(evaluationId) ? await getRow(evaluationId) : undefined
+      if (!truthy(evaluationId)) throw new Error('Missing evaluation_id in summary record')
+      if (ownedByOther(existing, caller)) {
+        errors.push(`evaluation_id ${evaluationId} belongs to a different teacher.`)
+      } else {
+        await updateRow(evaluationId, {
+          UpdateExpression: 'SET total_marks = :tm, updated_at = :ua, teacher_id = :tid',
+          ConditionExpression: '#type = :summary',
+          ExpressionAttributeNames: { '#type': 'type' },
+          ExpressionAttributeValues: { ':tm': totalMarks, ':ua': isoNaive(), ':tid': caller.user_id, ':summary': 'summary' },
+        })
+        updated.push({
+          type: 'summary',
+          evaluation_id: evaluationId,
+          updated: true,
+          total_marks: totalMarks,
+          student_id: summary.student_id ?? null,
+          assignment_id: summary.assignment_id ?? null,
+          qp_id: summary.qp_id ?? null,
+        })
+      }
+    } catch (err) {
+      if (isConditionalCheckFailed(err)) errors.push(`No summary record found with evaluation_id ${pyStr(evaluationId)}`)
+      else if (err?.name === 'ValueError') errors.push(`Invalid total_marks value for evaluation_id ${pyStr(evaluationId)}: ${err.message}`)
+      else errors.push(`Failed to update summary for evaluation_id ${pyStr(evaluationId)}: ${err?.message}`)
+    }
+  }
+
+  for (const record of details) {
+    const d = record && typeof record === 'object' ? record : {}
+    const { evaluation_id: evaluationId, question_number: questionNumber, subpart, marks, max_marks: maxMarks } = d
+    try {
+      if (!truthy(evaluationId)) {
+        errors.push('Missing evaluation_id in detail record')
+        continue
+      }
+      if (questionNumber === undefined || questionNumber === null) {
+        errors.push(`Missing question_number for evaluation_id ${evaluationId}`)
+        continue
+      }
+      if (marks === undefined || marks === null) {
+        errors.push(`Missing marks for evaluation_id ${evaluationId}`)
+        continue
+      }
+      const marksValue = decimal(marks)
+      const existing = await getRow(evaluationId)
+      if (ownedByOther(existing, caller)) {
+        errors.push(`evaluation_id ${evaluationId} belongs to a different teacher.`)
+        continue
+      }
+      let expression = 'SET marks = :m, updated_at = :ua, teacher_id = :tid'
+      const values = { ':m': marksValue, ':ua': isoNaive(), ':tid': caller.user_id, ':qn': questionNumber }
+      const hasMax = maxMarks !== undefined && maxMarks !== null
+      if (hasMax) {
+        expression += ', max_marks = :mm'
+        values[':mm'] = decimal(maxMarks)
+      }
+      await updateRow(evaluationId, {
+        UpdateExpression: expression,
+        ConditionExpression: '#qn = :qn',
+        ExpressionAttributeNames: { '#qn': 'question_number' },
+        ExpressionAttributeValues: values,
+      })
+      const row = {
+        type: 'details',
+        evaluation_id: evaluationId,
+        updated: true,
+        marks: marksValue,
+        question_number: pyStr(questionNumber),
+        subpart: subpart ?? null,
+      }
+      if (hasMax) row.max_marks = values[':mm']
+      updated.push(row)
+    } catch (err) {
+      if (isConditionalCheckFailed(err)) {
+        errors.push(
+          `No detail record found with evaluation_id ${evaluationId}, question_number ${pyStr(questionNumber)}, subpart ${pyStr(subpart)}`,
+        )
+      } else if (err?.name === 'ValueError') {
+        errors.push(`Invalid marks value for evaluation_id ${pyStr(evaluationId)}: ${err.message}`)
+      } else {
+        errors.push(`Failed to update details for evaluation_id ${pyStr(evaluationId)}: ${err?.message}`)
+      }
+    }
+  }
+
+  const response = {
+    message: 'Update completed',
+    updated_items: updated,
+    total_updated: updated.length,
+    success: errors.length === 0,
+    records_processed: { summary: 1, details: details.length },
+  }
+  if (errors.length) {
+    response.errors = errors
+    response.message = 'Update completed with some errors'
+  }
+  if (!updated.length) {
+    response.message = 'No records were updated'
+    return reply(404, response)
+  }
+  return reply(errors.length ? 207 : 200, response)
+}
+
+/** Total marks only, by evaluation_id; summary rows only. */
+export async function updateStudentGrade(body, caller) {
+  if (!['teacher', 'admin'].includes(caller.role)) throw forbidden('Only a teacher or admin can update grades.')
+  const { evaluation_id: evaluationId, total_marks: totalMarks } = body
+  if (!truthy(evaluationId)) throw badRequest('evaluation_id is required')
+  if (totalMarks === undefined || totalMarks === null) throw badRequest('total_marks is required')
+
+  const existing = await getRow(evaluationId)
+  if (ownedByOther(existing, caller)) throw forbidden('This assignment belongs to a different teacher.')
+  let value
+  try {
+    value = decimal(totalMarks)
+  } catch (err) {
+    throw badRequest(`Invalid number format: ${err.message}`)
+  }
+  try {
+    const res = await updateRow(evaluationId, {
+      UpdateExpression: 'SET total_marks = :tm, updated_at = :ua, teacher_id = :tid',
+      ConditionExpression: '#type = :summary',
+      ExpressionAttributeNames: { '#type': 'type' },
+      ExpressionAttributeValues: { ':tm': value, ':ua': isoNaive(), ':tid': caller.user_id, ':summary': 'summary' },
+      ReturnValues: 'ALL_NEW',
+    })
+    return {
+      message: 'Total marks updated successfully',
+      evaluation_id: evaluationId,
+      updated_attributes: res.Attributes ?? {},
+      total_marks: value,
+    }
+  } catch (err) {
+    if (isConditionalCheckFailed(err)) throw notFound(`No summary record found with evaluation_id ${evaluationId}`)
+    throw new HttpError(500, `Database error: ${err?.name ?? 'Error'}`)
+  }
+}
+
+export const operations = { updateMarks, updateStudentGrade }
diff --git a/backend/src/services/upload.service.js b/backend/src/services/upload.service.js
new file mode 100644
index 0000000..77d3ebf
--- /dev/null
+++ b/backend/src/services/upload.service.js
@@ -0,0 +1,53 @@
+// /uploadpdf — presigned S3 PUT URLs for answer sheets and question papers.
+// The original presign Lambda is not in this repository, so its S3 key layout
+// is not known here: keys follow UPLOAD_KEY_TEMPLATE, and the endpoint stays
+// off in production until UPLOAD_BUCKET is set. Point the template at the
+// layout the grading pipeline reads before enabling it.
+import { randomUUID } from 'node:crypto'
+import { storage } from '../aws/s3.js'
+import config from '../config/index.js'
+import { HttpError, badRequest, forbidden } from '../lib/errors.js'
+
+const ALLOWED_TYPES = new Set(['application/pdf'])
+const UPLOAD_TYPES = new Set(['student', 'teacher', 'answer'])
+const MAX_FILES = 20
+
+const safe = (v) => String(v ?? '').replace(/[^A-Za-z0-9._-]/g, '_').slice(0, 200) || '_'
+
+export function objectKey(meta, fileName) {
+  const values = {
+    uploadType: safe(meta.uploadType),
+    assignmentId: safe(meta.assignmentId),
+    qpId: safe(meta.qpId),
+    studentId: safe(meta.studentId),
+    courseId: safe(meta.courseId),
+    fileName: safe(fileName),
+    uuid: randomUUID(),
+  }
+  return config.storage.uploadKeyTemplate.replace(/\{(\w+)\}/g, (m, name) => values[name] ?? m)
+}
+
+export async function presignUploads(body, caller) {
+  const bucket = config.storage.uploadBucket
+  if (!bucket) throw new HttpError(503, 'File uploads are not configured on this server.')
+  if (!UPLOAD_TYPES.has(body.uploadType)) throw badRequest('uploadType must be student, teacher or answer.')
+  if (caller.role === 'student' && body.uploadType !== 'student') throw forbidden('Students can only upload answer sheets.')
+  if (caller.role === 'student' && body.studentId && body.studentId !== caller.user_id) {
+    throw forbidden('You can only upload your own answers.')
+  }
+  const files = Array.isArray(body.files) ? body.files : []
+  if (!files.length || files.length > MAX_FILES) throw badRequest(`Send between 1 and ${MAX_FILES} files.`)
+  for (const f of files) {
+    if (!f || typeof f.name !== 'string' || !f.name) throw badRequest('Every file needs a name.')
+    if (!ALLOWED_TYPES.has(f.type)) throw badRequest(`${f.name}: only PDF files can be uploaded.`)
+    if (!(Number(f.size) > 0) || Number(f.size) > config.storage.uploadMaxBytes) {
+      throw badRequest(`${f.name}: files must be under ${Math.round(config.storage.uploadMaxBytes / 1048576)} MB.`)
+    }
+  }
+  const meta = { ...body, studentId: body.studentId ?? (caller.role === 'student' ? caller.user_id : undefined) }
+  const store = storage()
+  const urls = await Promise.all(
+    files.map((f) => store.presignPut(bucket, objectKey(meta, f.name), f.type, config.storage.uploadUrlTtlSeconds)),
+  )
+  return { urls }
+}
