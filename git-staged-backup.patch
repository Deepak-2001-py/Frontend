+  await seedAnswers(a, 'S2', { graded: true, confidence: 0.6, sfx }) // 8/10, one answer flagged
+  await call('t@x.edu', 'approveRubric', {
+    assignment_id: a.assignment_id,
+    rubric: [
+      { question_number: 1, max_marks: 5 },
+      { question_number: 2, max_marks: 5 },
+    ],
+  })
+  return a
