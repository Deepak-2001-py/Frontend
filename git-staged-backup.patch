+++ b/backend/src/app.js
@@ -0,0 +1,18 @@
+// Express application (no listen() here, so tests can mount it on any port).
+import express from 'express'
+import config from './config/index.js'
+import { cors } from './middleware/cors.js'
+import { notFoundHandler } from './middleware/errors.js'
+import { requestLogger } from './middleware/requestLogger.js'
+import routes from './routes/index.js'
+
+export function createApp() {
+  const app = express()
+  app.disable('x-powered-by')
+  app.set('env', config.isProduction ? 'production' : 'development')
+  app.use(requestLogger())
+  app.use(cors())
+  app.use(config.server.basePath || '/', routes)
+  app.use(notFoundHandler)
+  return app
+}
diff --git a/backend/src/aws/bedrock.js b/backend/src/aws/bedrock.js
new file mode 100644
index 0000000..8380490
--- /dev/null
+++ b/backend/src/aws/bedrock.js
@@ -0,0 +1,56 @@
+// Claude on Amazon Bedrock (Bedrock Mantle Messages API) for the GradeFlow
+// assistant and rubric drafting. A policy decline (stop_reason "refusal") is
+// retried on BEDROCK_FALLBACK_MODEL_ID by the SDK's client-side refusal-fallback
+// middleware, as workflow.py did. AI_DRIVER=canned (development) never calls AWS.
+import { AnthropicBedrockMantle } from '@anthropic-ai/bedrock-sdk'
+import Anthropic, { BetaFallbackState, betaRefusalFallbackMiddleware } from '@anthropic-ai/sdk'
+import config from '../config/index.js'
+
+let claude
+let override
+
+function client() {
+  claude ??= new AnthropicBedrockMantle({
+    awsRegion: config.bedrock.region,
+    middleware: [betaRefusalFallbackMiddleware([{ model: config.bedrock.fallbackModelId }])],
+  })
+  return claude
+}
+
+/**
+ * Returns Claude's text reply, or null when every model in the chain declined.
+ * `outputFormat` (a json_schema format) makes the reply a JSON string.
+ */
+export async function askClaude({ system, messages, effort, maxTokens = 16000, outputFormat }) {
+  if (override) return override({ system, messages, effort, maxTokens, outputFormat })
+  if (config.drivers.ai === 'canned') {
+    // Keep the default rubric; give the assistant a clear "not connected" reply.
+    return outputFormat ? null : '(Local dev server — Claude is not called. Set AI_DRIVER=bedrock to use Amazon Bedrock.)'
+  }
+  // One fallback state per call: each request starts on the primary model.
+  const create = (params) => client().beta.messages.create(params, { fallbackState: new BetaFallbackState() })
+  const base = { model: config.bedrock.modelId, max_tokens: maxTokens, system, messages }
+  let response
+  try {
+    response = await create({ ...base, output_config: { effort, ...(outputFormat ? { format: outputFormat } : {}) } })
+  } catch (err) {
+    // Structured outputs aren't available on every Bedrock deployment; ask for
+    // the JSON in the prompt instead (callers parse it leniently).
+    if (!outputFormat || !(err instanceof Anthropic.BadRequestError)) throw err
+    response = await create({
+      ...base,
+      system: `${system}\n\nRespond with only a JSON object matching this JSON Schema, and no other text:\n${JSON.stringify(outputFormat.schema)}`,
+      output_config: { effort },
+    })
+  }
+  if (response.stop_reason === 'refusal') return null
+  return response.content
+    .filter((block) => block.type === 'text')
+    .map((block) => block.text)
+    .join('')
+}
+
+/** Tests replace Claude with a fake; pass undefined to restore. */
+export function setClaudeOverride(fn) {
+  override = fn
+}
diff --git a/backend/src/aws/dynamodb.js b/backend/src/aws/dynamodb.js
new file mode 100644
index 0000000..6ae55d9
--- /dev/null
+++ b/backend/src/aws/dynamodb.js
@@ -0,0 +1,116 @@
+// DynamoDB access (AWS SDK v3 document client). The same code runs against
+// real DynamoDB (production), DynamoDB Local (DYNAMODB_ENDPOINT), or an
+// in-process DynamoDB emulator (DB_DRIVER=memory, local development and tests)
+// — only the endpoint changes.
+import { DynamoDBClient } from '@aws-sdk/client-dynamodb'
+import {
+  DeleteCommand,
+  DynamoDBDocumentClient,
+  GetCommand,
+  PutCommand,
+  QueryCommand,
+  ScanCommand,
+  UpdateCommand,
+} from '@aws-sdk/lib-dynamodb'
+import config from '../config/index.js'
+
+let docClient
+let rawClient
+let localServer
+
+function makeClients(endpoint) {
+  const options = { region: config.aws.region }
+  if (endpoint) {
+    options.endpoint = endpoint
+    // Local emulators accept any credentials; never send real ones to them.
+    options.credentials = { accessKeyId: 'local', secretAccessKey: 'local' }
+  }
+  rawClient = new DynamoDBClient(options)
+  docClient = DynamoDBDocumentClient.from(rawClient, {
+    marshallOptions: { removeUndefinedValues: true },
+  })
+}
+
+/**
+ * Connects (and, for DB_DRIVER=memory, starts the in-process emulator and
+ * creates the tables). With SEED_DEMO_DATA=true a local database also gets the
+ * demo users and graded assignment. Call once at startup.
+ */
+export async function initDatabase({ seed = config.aws.seedDemoData, assignmentIndex = true } = {}) {
+  if (docClient) return
+  const local = config.drivers.db === 'memory' || Boolean(config.aws.dynamodbEndpoint)
+  if (config.drivers.db === 'memory') {
+    const { startLocalDynamo } = await import('../dev/localDynamo.js')
+    localServer = await startLocalDynamo()
+    makeClients(localServer.endpoint)
+  } else {
+    makeClients(config.aws.dynamodbEndpoint)
+  }
+  if (!local) return
+  const { createTables } = await import('../dev/schema.js')
+  await createTables(rawClient, { ifMissing: true, assignmentIndex })
+  if (seed) {
+    const { seedDemoData } = await import('../dev/seed.js')
+    await seedDemoData()
+  }
+}
+
+export async function closeDatabase() {
+  rawClient?.destroy()
+  docClient = undefined
+  rawClient = undefined
+  if (localServer) await localServer.close()
+  localServer = undefined
+}
+
+function client() {
+  if (!docClient) makeClients(config.aws.dynamodbEndpoint)
+  return docClient
+}
+
+async function paginate(Command, params) {
+  const items = []
+  let start
+  do {
+    const page = await client().send(new Command({ ...params, ExclusiveStartKey: start }))
+    items.push(...(page.Items ?? []))
+    start = page.LastEvaluatedKey
+  } while (start)
+  return items
+}
+
+/** Thin per-table helper; `name` is read lazily so tests can reconfigure tables. */
+export function table(getName) {
+  const TableName = () => (typeof getName === 'function' ? getName() : getName)
+  return {
+    get name() {
+      return TableName()
+    },
+    get: async (Key, extra = {}) => (await client().send(new GetCommand({ TableName: TableName(), Key, ...extra }))).Item,
+    put: (Item, extra = {}) => client().send(new PutCommand({ TableName: TableName(), Item, ...extra })),
+    update: (params) => client().send(new UpdateCommand({ TableName: TableName(), ...params })),
+    delete: (Key, extra = {}) => client().send(new DeleteCommand({ TableName: TableName(), Key, ...extra })),
+    queryAll: (params) => paginate(QueryCommand, { TableName: TableName(), ...params }),
+    scanAll: (params = {}) => paginate(ScanCommand, { TableName: TableName(), ...params }),
+  }
+}
+
+/** workflow.py's _to_dynamo: drops None/undefined map values, recursively. */
+export function clean(value) {
+  if (Array.isArray(value)) return value.map(clean)
+  if (value && typeof value === 'object') {
+    const out = {}
+    for (const [k, v] of Object.entries(value)) if (v !== null && v !== undefined) out[k] = clean(v)
+    return out
+  }
+  return value
+}
+
+/** Cheap connectivity probe for /health/ready. */
+export async function pingDatabase() {
+  await client().send(new GetCommand({ TableName: config.tables.users, Key: { email: '__healthcheck__' } }))
+}
+
+/** Missing-index / missing-table errors (used to detect the optional assignment_id GSI). */
+export const isMissingIndexError = (err) =>
+  err?.name === 'ValidationException' || err?.name === 'ResourceNotFoundException'
