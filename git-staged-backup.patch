+// HttpError carries a status and a message to the client. Each router decides
+// whether the message goes out as {"error": ...} or {"message": ...}, matching
+// the Python Lambda it replaces.
+export class HttpError extends Error {
+  constructor(status, message, { body } = {}) {
+    super(message)
+    this.status = status
+    // When set, sent as the whole response body instead of {<key>: message}.
+    this.body = body
+  }
+}
+
+export const badRequest = (message) => new HttpError(400, message)
+export const unauthorized = (message) => new HttpError(401, message)
+export const forbidden = (message) => new HttpError(403, message)
+export const notFound = (message) => new HttpError(404, message)
+export const conflict = (message) => new HttpError(409, message)
+
+/** A non-200 success-ish result (207 partial updates, 404 "nothing updated" with details). */
+export class Reply {
+  constructor(status, body) {
+    this.status = status
+    this.body = body
+  }
+}
+export const reply = (status, body) => new Reply(status, body)
+
+/** DynamoDB's conditional-check failure, regardless of client (SDK v3 or dynalite). */
+export const isConditionalCheckFailed = (err) => err?.name === 'ConditionalCheckFailedException'
diff --git a/backend/src/lib/passwords.js b/backend/src/lib/passwords.js
new file mode 100644
index 0000000..d096954
--- /dev/null
+++ b/backend/src/lib/passwords.js
@@ -0,0 +1,52 @@
+// Password hashing in the two storage formats already in the tables, so
+// existing accounts keep working:
+//   Users.password (login)          base64(32-byte salt + PBKDF2-SHA256, 100k)
+//   GradeAnt_Users.password_hash    "<salt hex>:<hash hex>", PBKDF2-SHA256, 200k
+// Hashing runs on the libuv pool so it never blocks the event loop.
+import { pbkdf2, randomBytes, randomInt, timingSafeEqual } from 'node:crypto'
+import { promisify } from 'node:util'
+
+const pbkdf2Async = promisify(pbkdf2)
+
+export async function hashLoginPassword(password, salt = randomBytes(32)) {
+  const hash = await pbkdf2Async(Buffer.from(password, 'utf8'), salt, 100_000, 32, 'sha256')
+  return Buffer.concat([salt, hash]).toString('base64')
+}
+
+export async function verifyLoginPassword(stored, provided) {
+  const raw = Buffer.from(String(stored), 'base64')
+  const salt = raw.subarray(0, 32)
+  const expected = raw.subarray(32)
+  const actual = await pbkdf2Async(Buffer.from(String(provided), 'utf8'), salt, 100_000, 32, 'sha256')
+  return expected.length === actual.length && timingSafeEqual(expected, actual)
+}
+
+export async function hashAdminPassword(password, saltHex) {
+  const salt = saltHex ? Buffer.from(saltHex, 'hex') : randomBytes(16)
+  const digest = await pbkdf2Async(Buffer.from(password, 'utf8'), salt, 200_000, 32, 'sha256')
+  return `${salt.toString('hex')}:${digest.toString('hex')}`
+}
+
+export async function verifyAdminPassword(password, stored) {
+  if (!stored || !String(stored).includes(':')) return false
+  const [saltHex] = String(stored).split(':', 1)
+  const candidate = Buffer.from(await hashAdminPassword(password, saltHex))
+  const expected = Buffer.from(String(stored))
+  return candidate.length === expected.length && timingSafeEqual(candidate, expected)
+}
+
+/** Same rules the change-password page shows: 8+ chars, an uppercase letter, a number. */
+export function passwordProblem(password) {
+  if (Array.from(password).length < 8) return 'Password must be at least 8 characters.'
+  if (!/\p{Lu}/u.test(password)) return 'Password must include an uppercase letter.'
+  if (!/\p{Nd}/u.test(password)) return 'Password must include a number.'
+  return null
+}
+
+/** Human-typeable temp password: no ambiguous chars (0/O, 1/l/I). */
+export function generateTempPassword() {
+  const alphabet = 'ABCDEFGHJKMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789'
+  let out = ''
+  for (let i = 0; i < 12; i++) out += alphabet[randomInt(alphabet.length)]
+  return out
+}
diff --git a/backend/src/lib/py.js b/backend/src/lib/py.js
new file mode 100644
index 0000000..23f5e90
--- /dev/null
+++ b/backend/src/lib/py.js
@@ -0,0 +1,122 @@
+// Small helpers that reproduce the Python Lambdas' semantics where JavaScript
+// differs (truthiness, float(), round(), str[:n], tuple sorting, isoformat),
+// so the API answers exactly as before.
+
+/** Python truthiness: [], {}, '', 0, None and False are all falsy. */
+export function truthy(v) {
+  if (Array.isArray(v)) return v.length > 0
+  if (v && typeof v === 'object') return Object.keys(v).length > 0
+  return Boolean(v)
+}
+
+/** `a or b` with Python truthiness. */
+export const or = (...values) => {
+  for (const v of values) if (truthy(v)) return v
+  return values[values.length - 1]
+}
+
+/** workflow.py's _num(): float(value), or `fallback` when Python's float() would raise. */
+export function num(value, fallback = 0) {
+  if (typeof value === 'number') return value
+  if (typeof value === 'boolean') return value ? 1 : 0
+  if (typeof value === 'string') {
+    const s = value.trim().replace(/_/g, '')
+    const special = /^([+-]?)(inf|infinity|nan)$/i.exec(s)
+    if (special) return special[2].toLowerCase() === 'nan' ? NaN : special[1] === '-' ? -Infinity : Infinity
+    return /^[+-]?(\d+\.?\d*|\.\d+)(e[+-]?\d+)?$/i.test(s) ? Number(s) : fallback
+  }
+  return fallback
+}
+
+/** Python's round(): half to even. */
+export function pyRound(x) {
+  const r = Math.round(x)
+  return Math.abs(x % 1) === 0.5 && r % 2 !== 0 ? r - 1 : r
+}
+
+/** str(value)[:n] on code points, like Python slicing. */
+export function trunc(value, n) {
+  const s = String(value)
+  return s.length <= n ? s : Array.from(s).slice(0, n).join('')
+}
+
+/** Python str() for the scalar values that come out of DynamoDB / JSON. */
+export function pyStr(v) {
+  if (v === null || v === undefined) return 'None'
+  if (v === true) return 'True'
+  if (v === false) return 'False'
+  return String(v)
+}
+
+/** Python's repr() for the values used in error messages. */
+export function pyRepr(v) {
+  if (typeof v === 'string') return `'${v.replace(/\\/g, '\\\\').replace(/'/g, "\\'")}'`
+  return pyStr(v)
+}
+
+/** Compare like Python: numbers numerically, strings by code point, tuples element-wise. */
+export function cmp(a, b) {
+  if (Array.isArray(a) && Array.isArray(b)) {
+    for (let i = 0; i < Math.min(a.length, b.length); i++) {
+      const c = cmp(a[i], b[i])
+      if (c) return c
+    }
+    return a.length - b.length
+  }
+  if (typeof a === 'number' && typeof b === 'number') return a < b ? -1 : a > b ? 1 : 0
+  if (typeof a === 'boolean' || typeof b === 'boolean') return cmp(Number(a), Number(b))
+  // Mixed types (Python would raise): numbers sort before strings.
+  if (typeof a !== typeof b) return typeof a === 'number' ? -1 : 1
+  const sa = String(a)
+  const sb = String(b)
+  return sa < sb ? -1 : sa > sb ? 1 : 0
+}
+
+/** sorted(items, key=fn, reverse=...) — stable, Python ordering. */
+export function sortBy(items, key, { reverse = false } = {}) {
+  const decorated = items.map((item, i) => ({ item, k: key(item), i }))
+  decorated.sort((x, y) => (reverse ? cmp(y.k, x.k) : cmp(x.k, y.k)) || x.i - y.i)
+  return decorated.map((d) => d.item)
+}
+
+/** min(values, default=fallback) with Python ordering. */
+export function pyMin(values, fallback) {
+  let best
+  let found = false
+  for (const v of values) {
+    if (!found || cmp(v, best) < 0) {
+      best = v
+      found = true
+    }
+  }
+  return found ? best : fallback
+}
+
+export const mean = (values) => {
+  const list = Array.from(values)
+  return list.length ? list.reduce((a, b) => a + b, 0) / list.length : null
+}
+
+export const sum = (values) => Array.from(values).reduce((a, b) => a + b, 0)
+
+/** Python's datetime.isoformat() for a UTC instant: 2026-10-19T09:00:00.123000+00:00 */
+export function isoUtc(date = new Date()) {
+  const iso = date.toISOString() // 2026-10-19T09:00:00.123Z
+  const ms = date.getUTCMilliseconds()
+  return ms ? `${iso.slice(0, 19)}.${String(ms).padStart(3, '0')}000+00:00` : `${iso.slice(0, 19)}+00:00`
+}
+
+/** Python's datetime.now().isoformat() as the old Lambdas wrote it (naive, UTC on Lambda). */
+export function isoNaive(date = new Date()) {
+  return isoUtc(date).replace('+00:00', '')
+}
+
+/** datetime.date.fromisoformat(s[:10]) — returns 'YYYY-MM-DD' or null when invalid. */
+export function isoDate(value) {
+  const s = pyStr(value).slice(0, 10)
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(s)) return null
+  const d = new Date(`${s}T00:00:00Z`)
+  return Number.isNaN(d.getTime()) || d.toISOString().slice(0, 10) !== s ? null : s
+}
+
+export const daysBetween = (a, b) => Math.round((Date.parse(`${a}T00:00:00Z`) - Date.parse(`${b}T00:00:00Z`)) / 86400000)
diff --git a/backend/src/lib/tokens.js b/backend/src/lib/tokens.js
new file mode 100644
index 0000000..2071421
--- /dev/null
+++ b/backend/src/lib/tokens.js
@@ -0,0 +1,90 @@
+// Two token formats, both inherited from the Python Lambdas:
+//  - HS256 JWTs issued by /auth/login (payload: user_id, email, iat, exp)
+//  - the admin console's own HMAC session tokens, issued by completeFirstLogin:
+//    base64url(json(claims)) + "." + hex(hmac_sha256(that base64 string))
+import { createHmac, timingSafeEqual } from 'node:crypto'
+import jwt from 'jsonwebtoken'
+import { getJwtSecret, getSessionTokenSecret } from '../aws/secrets.js'
+import config from '../config/index.js'
+import { unauthorized } from './errors.js'
+
+const nowSeconds = () => Math.floor(Date.now() / 1000)
+
+export async function issueLoginToken(userId, email) {
+  const iat = nowSeconds()
+  const payload = { user_id: userId, email, exp: iat + config.auth.tokenExpirySeconds, iat }
+  return jwt.sign(payload, await getJwtSecret(), { algorithm: 'HS256' })
+}
+
+/** Payload of a valid login JWT, or a reason it's invalid: 'expired' | 'invalid'. */
+export async function decodeLoginToken(token) {
+  try {
+    return { payload: jwt.verify(token, await getJwtSecret(), { algorithms: ['HS256'] }) }
+  } catch (err) {
+    return { error: err?.name === 'TokenExpiredError' ? 'expired' : 'invalid' }
+  }
+}
+
+const b64url = (buf) => Buffer.from(buf).toString('base64url')
+const fromB64url = (s) => {
+  if (!/^[A-Za-z0-9_-]*$/.test(s)) throw new Error('bad base64')
+  return Buffer.from(s, 'base64url')
+}
+const safeEqual = (a, b) => {
+  const x = Buffer.from(a)
+  const y = Buffer.from(b)
+  return x.length === y.length && timingSafeEqual(x, y)
+}
+
+/**
+ * lambda_admin.py's _verify_login_jwt: verifies the login JWT by hand with the
+ * admin console's error messages (and, like it, treats a missing exp as expired).
+ */
+export async function verifyLoginJwtForAdmin(token) {
+  const secret = await getJwtSecret()
+  if (!secret) throw unauthorized('Server misconfigured: JWT_SECRET is not set.')
+  let header, payload
+  const [headerB64, payloadB64, signatureB64] = token.split('.')
+  try {
+    header = JSON.parse(fromB64url(headerB64).toString('utf8'))
+    payload = JSON.parse(fromB64url(payloadB64).toString('utf8'))
+  } catch {
+    throw unauthorized('Malformed session token.')
+  }
+  if (header?.alg !== 'HS256') throw unauthorized('Invalid session token.')
+  const expected = b64url(createHmac('sha256', secret).update(`${headerB64}.${payloadB64}`).digest())
+  if (!safeEqual(expected, signatureB64)) throw unauthorized('Invalid session token.')
+  if (!((payload?.exp ?? 0) >= Date.now() / 1000)) throw unauthorized('Session expired.')
+  return payload
+}
+
+export async function makeSessionToken(claims, ttlSeconds) {
+  const payloadB64 = b64url(JSON.stringify({ ...claims, exp: nowSeconds() + ttlSeconds }))
+  const signature = createHmac('sha256', await sessionSecret()).update(payloadB64).digest('hex')
+  return `${payloadB64}.${signature}`
+}
+
+export async function verifySessionToken(token) {
+  const dot = token.indexOf('.')
+  if (dot < 0) throw unauthorized('Malformed session token.')
+  const payloadB64 = token.slice(0, dot)
+  const signature = token.slice(dot + 1)
+  const expected = createHmac('sha256', await sessionSecret()).update(payloadB64).digest('hex')
+  if (!safeEqual(expected, signature)) throw unauthorized('Invalid session token.')
+  let claims
+  try {
+    claims = JSON.parse(fromB64url(payloadB64).toString('utf8'))
+  } catch {
+    throw unauthorized('Malformed session token.')
+  }
+  if (!((claims?.exp ?? 0) >= Date.now() / 1000)) throw unauthorized('Session expired.')
+  return claims
+}
+
+async function sessionSecret() {
+  const secret = await getSessionTokenSecret()
+  if (secret) return secret
+  // lambda_admin.py fell back to an insecure default; only allow that outside production.
+  if (config.isProduction) throw unauthorized('Server misconfigured: SESSION_TOKEN_SECRET is not set.')
+  return 'dev-only-insecure-secret-CHANGE-ME'
+}
diff --git a/backend/src/middleware/auth.js b/backend/src/middleware/auth.js
new file mode 100644
index 0000000..2cacdae
--- /dev/null
+++ b/backend/src/middleware/auth.js
@@ -0,0 +1,39 @@
+// Bearer-token authentication for /getgrades, /correctanswer, /updatedb and
+// /workflow (same rules as their Python Lambdas): an HS256 JWT from
+// /auth/login, whose account must still exist. The role is read fresh from the
+// Users table on every request, so a demoted or deleted user loses access at once.
+import { getJwtSecret } from '../aws/secrets.js'
+import { HttpError, unauthorized } from '../lib/errors.js'
+import { decodeLoginToken } from '../lib/tokens.js'
+import { getUserByEmail } from '../repositories/users.repository.js'
+
+export function bearerToken(req) {
+  const header = req.get('authorization') ?? ''
+  return header.startsWith('Bearer ') ? header.slice('Bearer '.length).trim() : null
+}
+
+/** Returns { user_id, email, role, user } or throws a 401 HttpError. */
+export async function authenticate(req) {
+  if (!(await getJwtSecret())) throw new HttpError(500, 'Server misconfigured: JWT_SECRET is not set.')
+  const token = bearerToken(req)
+  if (token === null) throw unauthorized('Missing Authorization: Bearer <token> header.')
+  const { payload, error } = await decodeLoginToken(token)
+  if (error === 'expired') throw unauthorized('Session expired — please log in again.')
+  if (error) throw unauthorized('Invalid session token.')
+  const { email, user_id: userId } = payload
+  if (!email || !userId) throw unauthorized('Malformed session token.')
+  const user = await getUserByEmail(email)
+  if (!user || user.user_id !== userId) throw unauthorized('Account no longer exists.')
+  return { user_id: userId, email, role: user.userRole ?? 'student', user }
+}
+
+/** Express middleware: sets req.caller. */
+export const requireCaller = async (req, res, next) => {
+  req.caller = await authenticate(req)
+  next()
+}
+
+/** Throws 403 unless the caller has one of `roles`. */
+export function requireRole(caller, roles, message) {
+  if (!roles.includes(caller.role)) throw new HttpError(403, message)
+}
diff --git a/backend/src/middleware/cors.js b/backend/src/middleware/cors.js
new file mode 100644
index 0000000..711a086
--- /dev/null
+++ b/backend/src/middleware/cors.js
@@ -0,0 +1,22 @@
+// CORS for the React app. CORS_ALLOWED_ORIGINS is "*" or an allowlist; the
+// API uses bearer tokens (no cookies), so credentials are never allowed.
+import config from '../config/index.js'
+
+export function cors() {
+  const { origins } = config.cors
+  const anyOrigin = origins.includes('*') || (origins.length === 0 && !config.isProduction)
+  return (req, res, next) => {
+    const origin = req.headers.origin
+    if (anyOrigin) {
+      res.set('Access-Control-Allow-Origin', '*')
+    } else {
+      res.vary('Origin')
+      if (origin && origins.includes(origin)) res.set('Access-Control-Allow-Origin', origin)
+    }
+    res.set('Access-Control-Allow-Headers', 'Content-Type, Authorization')
+    res.set('Access-Control-Allow-Methods', 'GET, POST, PUT, OPTIONS')
+    res.set('Access-Control-Max-Age', '600')
+    if (req.method === 'OPTIONS') return res.status(204).end()
+    next()
+  }
+}
diff --git a/backend/src/middleware/errors.js b/backend/src/middleware/errors.js
new file mode 100644
index 0000000..467d7bf
--- /dev/null
+++ b/backend/src/middleware/errors.js
@@ -0,0 +1,38 @@
+// Error handling. Each API keeps the error shape its Python Lambda used:
+// {"error": "..."} for /getgrades, /correctanswer, /updatedb, /workflow and
+// {"message": "..."} for /auth/* and /admin. Unexpected errors are logged with
+// the request id and answered with a generic 500 (no internals leaked).
+import express from 'express'
+import config from '../config/index.js'
+import { HttpError } from '../lib/errors.js'
+
+/** JSON body parser for one router; malformed JSON becomes a 400 in that router's shape. */
+export const jsonBody = () => express.json({ type: () => true, limit: config.server.bodyLimit })
+
+export function errorHandler({ key, invalidJson = 'Invalid JSON in request body', internal = 'Internal server error' }) {
+  // Express recognises error handlers by their four parameters.
+  // eslint-disable-next-line no-unused-vars
+  return (err, req, res, _next) => {
+    if (err instanceof HttpError) {
+      return res.status(err.status).json(err.body ?? { [key]: err.message })
+    }
+    if (err?.type === 'entity.parse.failed') return res.status(400).json({ [key]: invalidJson })
+    if (err?.type === 'entity.too.large') return res.status(413).json({ [key]: 'Request body too large.' })
+    console.error(
+      JSON.stringify({
+        level: 'error',
+        msg: 'unhandled error',
+        requestId: req.get('lambda-web-request-id'),
+        path: req.path,
+        error: err?.name,
+        detail: err?.message,
+        stack: config.isProduction ? undefined : err?.stack,
+      }),
+    )
+    res.status(500).json({ [key]: config.isProduction ? internal : `${internal}: ${err?.message}` })
+  }
+}
+
+export function notFoundHandler(req, res) {
+  res.status(404).json({ message: 'Not Found' })
+}
diff --git a/backend/src/middleware/requestLogger.js b/backend/src/middleware/requestLogger.js
new file mode 100644
index 0000000..c8015d8
--- /dev/null
+++ b/backend/src/middleware/requestLogger.js
@@ -0,0 +1,25 @@
+// One structured log line per request, tagged with the lambda-web-request-id
+// header Lambda adds (so a client error can be matched to its log). Never logs
+// bodies or tokens.
+import config from '../config/index.js'
+
+export function requestLogger() {
+  return (req, res, next) => {
+    if (!config.server.logRequests) return next()
+    const started = process.hrtime.bigint()
+    res.on('finish', () => {
+      console.log(
+        JSON.stringify({
+          level: 'info',
+          requestId: req.get('lambda-web-request-id'),
+          method: req.method,
+          path: req.originalUrl.split('?')[0],
+          operation: typeof req.body?.operation === 'string' ? req.body.operation : undefined,
+          status: res.statusCode,
+          ms: Number((process.hrtime.bigint() - started) / 1000000n),
+        }),
+      )
+    })
+    next()
+  }
+}
diff --git a/backend/src/repositories/admin.repository.js b/backend/src/repositories/admin.repository.js
new file mode 100644
index 0000000..f5aebf3
--- /dev/null
+++ b/backend/src/repositories/admin.repository.js
@@ -0,0 +1,45 @@
+// Admin console tables (lambda_admin.py). All keyed by a single string id:
+//   GradeAnt_Users (user_id) · GradeAnt_ResetRequests (request_id) ·
+//   GradeAnt_Content (post_id) · GradeAnt_Tickets (ticket_id) ·
+//   GradeAnt_AuditLogs (log_id) · GradeAnt_Settings (setting_key) ·
+//   GradeAnt_Invites (token) · GradeAnt_Analytics (metric_key)
+import { table } from '../aws/dynamodb.js'
+import config from '../config/index.js'
+
+export const adminUsers = table(() => config.tables.adminUsers)
+export const resetRequests = table(() => config.tables.resetRequests)
+export const content = table(() => config.tables.content)
+export const tickets = table(() => config.tables.tickets)
+export const auditLogs = table(() => config.tables.auditLogs)
+export const settings = table(() => config.tables.settings)
+export const invites = table(() => config.tables.invites)
+export const analytics = table(() => config.tables.analytics)
+
+/** Build a scan filter from equality conditions, e.g. { role: 'teacher', status: 'active' }. */
+export function equalsFilter(conditions) {
+  const entries = Object.entries(conditions).filter(([, v]) => v !== undefined)
+  if (!entries.length) return {}
+  const names = {}
+  const values = {}
+  const parts = entries.map(([field, value], i) => {
+    names[`#f${i}`] = field
+    values[`:v${i}`] = value
+    return `#f${i} = :v${i}`
+  })
+  return { FilterExpression: parts.join(' AND '), ExpressionAttributeNames: names, ExpressionAttributeValues: values }
+}
+
+/** Set one or more attributes on an item: setFields({ status: 'active' }). */
+export function setFields(fields, extra = {}) {
+  const names = {}
+  const values = {}
+  const parts = Object.entries(fields).map(([field, value], i) => {
+    names[`#f${i}`] = field
+    values[`:v${i}`] = value
+    return `#f${i} = :v${i}`
+  })
+  return { UpdateExpression: `SET ${parts.join(', ')}`, ExpressionAttributeNames: names, ExpressionAttributeValues: values, ...extra }
+}
+
+export const pendingResetRequestsFor = (userId) =>
+  resetRequests.scanAll(equalsFilter({ user_id: userId, status: 'pending' }))
diff --git a/backend/src/repositories/grading.repository.js b/backend/src/repositories/grading.repository.js
new file mode 100644
index 0000000..7ff319d
--- /dev/null
+++ b/backend/src/repositories/grading.repository.js
@@ -0,0 +1,76 @@
+// assignment_grading: one row per question per student plus one
+// type="summary" row per student, keyed by evaluation_id. GSIs:
+// student_id-index, type-index and (optional, recommended) assignment_id-index.
+import { isMissingIndexError, table } from '../aws/dynamodb.js'
+import config from '../config/index.js'
+
+const grading = table(() => config.tables.grading)
+
+export const getRow = (evaluationId) => grading.get({ evaluation_id: evaluationId })
+
+export const updateRow = (evaluationId, params) => grading.update({ Key: { evaluation_id: evaluationId }, ...params })
+
+/**
+ * Rows for one student. `filters` (all ANDed):
+ *   assignmentId, qpId, questionNumber  → equality
+ *   type: 'summary' | 'notSummary'
+ */
+export function studentRows(studentId, { assignmentId, qpId, questionNumber, type } = {}) {
+  const names = {}
+  const values = { ':sid': studentId }
+  const conditions = []
+  if (assignmentId !== undefined) {
+    names['#aid'] = 'assignment_id'
+    values[':aid'] = assignmentId
+    conditions.push('#aid = :aid')
+  }
+  if (qpId !== undefined) {
+    names['#qp'] = 'qp_id'
+    values[':qp'] = qpId
+    conditions.push('#qp = :qp')
+  }
+  if (questionNumber !== undefined) {
+    names['#qn'] = 'question_number'
+    values[':qn'] = questionNumber
+    conditions.push('#qn = :qn')
+  }
+  if (type) {
+    names['#type'] = 'type'
+    values[':summary'] = 'summary'
+    conditions.push(type === 'summary' ? '#type = :summary' : '#type <> :summary')
+  }
+  return grading.queryAll({
+    IndexName: 'student_id-index',
+    KeyConditionExpression: 'student_id = :sid',
+    ...(conditions.length ? { FilterExpression: conditions.join(' AND ') } : {}),
+    ...(Object.keys(names).length ? { ExpressionAttributeNames: names } : {}),
+    ExpressionAttributeValues: values,
+  })
+}
+
+/** Every student's summary row for one assignment / question paper (type-index). */
+export const summaryRows = (assignmentId, qpId) =>
+  grading.queryAll({
+    IndexName: 'type-index',
+    KeyConditionExpression: '#type = :summary',
+    FilterExpression: '#aid = :aid AND #qp = :qp',
+    ExpressionAttributeNames: { '#type': 'type', '#aid': 'assignment_id', '#qp': 'qp_id' },
+    ExpressionAttributeValues: { ':summary': 'summary', ':aid': assignmentId, ':qp': qpId },
+  })
+
+/** All rows via the assignment_id GSI, or null when that index doesn't exist. */
+export async function assignmentRows(assignmentId, qpId) {
+  try {
+    const rows = await grading.queryAll({
+      IndexName: config.tables.gradingAssignmentIndex,
+      KeyConditionExpression: '#aid = :aid',
+      FilterExpression: '#qp = :qp',
+      ExpressionAttributeNames: { '#aid': 'assignment_id', '#qp': 'qp_id' },
+      ExpressionAttributeValues: { ':aid': assignmentId, ':qp': qpId },
+    })
+    return rows.filter((r) => r.student_id)
+  } catch (err) {
+    if (isMissingIndexError(err)) return null
+    throw err
+  }
+}
diff --git a/backend/src/repositories/users.repository.js b/backend/src/repositories/users.repository.js
new file mode 100644
index 0000000..ae537e8
--- /dev/null
+++ b/backend/src/repositories/users.repository.js
@@ -0,0 +1,55 @@
+// Users table (login accounts), keyed by email. Written by /auth/*, read by
+// every authenticated API to look up the caller's role.
+import { table } from '../aws/dynamodb.js'
+import config from '../config/index.js'
+
+const users = table(() => config.tables.users)
+
+export const getUserByEmail = (email) => users.get({ email })
+
+export const putUser = (item) => users.put(item)
+
+export const setLastLogin = (email, at) =>
+  users.update({
+    Key: { email },
+    UpdateExpression: 'set last_login = :login_time',
+    ExpressionAttributeValues: { ':login_time': at },
+  })
+
+export const setPassword = (email, passwordHash, at) =>
+  users.update({
+    Key: { email },
+    UpdateExpression: 'set password = :p, must_change_password = :f, updated_at = :t',
+    ExpressionAttributeValues: { ':p': passwordHash, ':f': false, ':t': at },
+  })
+
+export const setPhotoKey = (email, key) =>
+  users.update({
+    Key: { email },
+    UpdateExpression: 'set photo_key = :k',
+    ExpressionAttributeValues: { ':k': key },
+  })
+
+/** Admin-issued temp password; the condition stops it creating a stray item for a deleted account. */
+export const setTempPassword = (email, userId, passwordHash) =>
+  users.update({
+    Key: { email },
+    UpdateExpression: 'SET password = :p, must_change_password = :true',
+    ConditionExpression: '#uid = :uid',
+    ExpressionAttributeNames: { '#uid': 'user_id' },
+    ExpressionAttributeValues: { ':p': passwordHash, ':true': true, ':uid': userId },
+  })
+
+export const setGradingSettings = (email, settings) =>
+  users.update({
+    Key: { email },
+    UpdateExpression: 'SET gradeant_settings = :s',
+    ExpressionAttributeValues: { ':s': settings },
+  })
+
+/** Everyone, with just the fields the workflow screens need. */
+export const listDirectory = () =>
+  users.scanAll({
+    ProjectionExpression: 'user_id, email, #n, userRole, classes',
+    ExpressionAttributeNames: { '#n': 'name' },
+  })
diff --git a/backend/src/repositories/workflow.repository.js b/backend/src/repositories/workflow.repository.js
new file mode 100644
index 0000000..c9155b6
--- /dev/null
+++ b/backend/src/repositories/workflow.repository.js
@@ -0,0 +1,65 @@
+// Tables owned by the assignment workflow:
+//   GradeAnt_Assignments    PK assignment_id; GSI teacher_id-index
+//   GradeAnt_Submissions    PK assignment_id, SK student_id; GSI student_id-index
+//   GradeAnt_Announcements  PK announcement_id
+import { table } from '../aws/dynamodb.js'
+import config from '../config/index.js'
+
+const assignments = table(() => config.tables.assignments)
+const submissions = table(() => config.tables.submissions)
+const announcements = table(() => config.tables.announcements)
+
+// ---- Assignments ----
+
+export const getAssignment = (assignmentId) => assignments.get({ assignment_id: assignmentId })
+export const putAssignment = (item) => assignments.put(item)
+export const updateAssignment = (assignmentId, params) => assignments.update({ Key: { assignment_id: assignmentId }, ...params })
+export const scanAssignments = () => assignments.scanAll()
+
+export const assignmentsByTeacher = (teacherId) =>
+  assignments.queryAll({
+    IndexName: 'teacher_id-index',
+    KeyConditionExpression: 'teacher_id = :t',
+    ExpressionAttributeValues: { ':t': teacherId },
+  })
+
+export const publishedAssignments = () =>
+  assignments.scanAll({
+    FilterExpression: 'content_status = :p',
+    ExpressionAttributeValues: { ':p': 'published' },
+  })
+
+// ---- Submissions ----
+
+export const getSubmission = (assignmentId, studentId) => submissions.get({ assignment_id: assignmentId, student_id: studentId })
+
+export const submissionsForAssignment = (assignmentId) =>
+  submissions.queryAll({
+    KeyConditionExpression: 'assignment_id = :a',
+    ExpressionAttributeValues: { ':a': assignmentId },
+  })
+
+export const updateSubmission = (assignmentId, studentId, params) =>
+  submissions.update({ Key: { assignment_id: assignmentId, student_id: studentId }, ...params })
+
+// ---- Announcements ----
+
+export const getAnnouncement = (id) => announcements.get({ announcement_id: id })
+export const putAnnouncement = (item) => announcements.put(item)
+export const deleteAnnouncement = (id) => announcements.delete({ announcement_id: id })
+export const scanAnnouncements = () => announcements.scanAll()
+
+export const announcementsByAuthor = (authorId) =>
+  announcements.scanAll({
+    FilterExpression: 'author_id = :a',
+    ExpressionAttributeValues: { ':a': authorId },
+  })
+
+export function announcementsForClasses(classes) {
+  const values = {}
+  classes.forEach((c, i) => (values[`:c${i}`] = c))
+  return announcements.scanAll({
+    FilterExpression: `class_name IN (${Object.keys(values).join(', ')})`,
+    ExpressionAttributeValues: values,
+  })
+}
