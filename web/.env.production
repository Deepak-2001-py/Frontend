# npm run build — the deployed API. Only public URLs here (they are compiled
# into the bundle). Docker builds can override with --build-arg VITE_API_BASE_URL=...
#
# Until the Node backend is deployed this stays on the current API Gateway stage.
# After deploying it (see backend/README.md), set VITE_API_BASE_URL to the Web
# Function endpoint (https://<id>.<x>.lambda-web.<region>.on.aws or your CloudFront
# domain) and, once the Node /uploadpdf is enabled, remove VITE_UPLOAD_BASE_URL.
VITE_API_BASE_URL=https://rus9nultj9.execute-api.eu-north-1.amazonaws.com/dev
VITE_UPLOAD_BASE_URL=https://rus9nultj9.execute-api.eu-north-1.amazonaws.com/dev
