# Web app settings (Vite). Every VITE_* value is compiled into the browser
# bundle, so only public values belong here — never secrets or AWS credentials.
#
# Loaded by mode: .env.development (npm run dev) / .env.production (npm run build),
# then .env.<mode>.local (gitignored) for personal overrides.

# Base URL of the GradeAnt API (no trailing slash).
#   local Node backend:  http://localhost:8787
#   Lambda Web Function: https://<id>.<x>.lambda-web.<region>.on.aws
#   legacy API Gateway:  https://rus9nultj9.execute-api.eu-north-1.amazonaws.com/dev
VITE_API_BASE_URL=http://localhost:8787

# Path of the assignment workflow resource on that API.
VITE_WORKFLOW_PATH=/workflow

# Optional: send /uploadpdf to a different API (the legacy upload Lambda), which
# is called without the user's token. Leave unset when the Node backend handles uploads.
VITE_UPLOAD_BASE_URL=
