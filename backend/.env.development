# Local development on the local Supabase stack (npx supabase start, needs Docker):
#   - database: Supabase Postgres (schema: ../supabase/migrations), demo data loaded on start
#   - logins: Supabase Auth (keys: npm run supabase:env → .env.development.local)
#   - S3: files under .data/storage (presigned-style URLs served by this server)
#   - email / notifications / grading pipeline: logged, not sent
#   - Claude: canned replies (set AI_DRIVER=bedrock in .env.development.local to use Bedrock)
# No Docker? npm run dev:offline uses an in-memory DynamoDB and this API's own logins.
# Personal overrides and secrets go in .env.development.local (gitignored).
APP_ENV=development
HOST=127.0.0.1
PORT=8787
CORS_ALLOWED_ORIGINS=*

DB_DRIVER=postgres
AUTH_DRIVER=supabase
STORAGE_DRIVER=local
MAIL_DRIVER=log
NOTIFY_DRIVER=log
JOBS_DRIVER=inline
AI_DRIVER=canned
GRADING_DRIVER=log
SEED_DEMO_DATA=true

AWS_DATA_REGION=us-east-1

# Local-only signing keys (never used anywhere else).
JWT_SECRET=local-dev-secret-local-dev-secret-0123456789
SESSION_TOKEN_SECRET=local-dev-secret-local-dev-secret-0123456789

PROFILE_PHOTO_BUCKET=local-profile-photos
UPLOAD_BUCKET=local-uploads
APP_BASE_URL=http://localhost:5173

# The local Supabase stack's default database and API (not secrets: they only exist on this
# machine). The Supabase keys go in .env.development.local (npm run supabase:env).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
