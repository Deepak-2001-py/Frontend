# Local development: everything runs on this machine, no AWS account needed.
#   - DynamoDB: in-process emulator, tables created and demo data loaded on start
#   - S3: files under .data/storage (presigned-style URLs served by this server)
#   - email / notifications / grading pipeline: logged, not sent
#   - Claude: canned replies (set AI_DRIVER=bedrock in .env.development.local to use Bedrock)
# Personal overrides and secrets go in .env.development.local (gitignored).
APP_ENV=development
HOST=127.0.0.1
PORT=8787
CORS_ALLOWED_ORIGINS=*

DB_DRIVER=memory
STORAGE_DRIVER=local
MAIL_DRIVER=log
NOTIFY_DRIVER=log
JOBS_DRIVER=inline
AI_DRIVER=canned
GRADING_DRIVER=log
SEED_DEMO_DATA=true

AWS_DATA_REGION=us-east-1

# Local-only signing keys (never used anywhere else).
JWT_SECRET=local-dev-secret-local-dev-secret-0123456789
SESSION_TOKEN_SECRET=local-dev-secret-local-dev-secret-0123456789

PROFILE_PHOTO_BUCKET=local-profile-photos
UPLOAD_BUCKET=local-uploads
APP_BASE_URL=http://localhost:5173
