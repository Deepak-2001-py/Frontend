# GradeAnt API — every setting, documented. No real values belong in this file.
#
# Files loaded (later never overrides earlier, and real environment variables
# always win):  .env.<mode>  then  .env.<mode>.local (gitignored, for secrets)
# Mode: --mode=<name> (npm scripts) › APP_ENV › production when running on
# Lambda Web Functions › development.

# ---- Mode & server ----------------------------------------------------------------
# development | production | test
APP_ENV=
# Local listen address. On Lambda the runtime sets AWS_LAMBDA_HTTP_ENDPOINT instead.
HOST=127.0.0.1
PORT=8787
# Optional path prefix for every route (e.g. /dev behind a front door that adds one).
API_BASE_PATH=
# Public URL of this server; only used to build local-storage links in development.
PUBLIC_BASE_URL=
BODY_LIMIT=1mb
LOG_REQUESTS=true

# Comma-separated web app origins allowed by CORS, or * (required in production).
CORS_ALLOWED_ORIGINS=

# ---- Drivers: what each integration talks to ---------------------------------------
# memory (in-process DynamoDB emulator, dev only) | dynamodb
DB_DRIVER=
# local (files under LOCAL_STORAGE_DIR) | s3
STORAGE_DRIVER=
# log | ses
MAIL_DRIVER=
# log | sns
NOTIFY_DRIVER=
# inline (run jobs in the request) | sqs (send to JOBS_QUEUE_URL, run by worker.js)
JOBS_DRIVER=
# canned (no AI calls) | bedrock
AI_DRIVER=
# log | lambda (invoke GRADING_FUNCTION_NAME)
GRADING_DRIVER=

# ---- AWS ----------------------------------------------------------------------------
# Region of the DynamoDB tables, S3 buckets, SES, SNS, SQS. AWS_REGION is reserved on
# Lambda Web Functions (it is the function's own Region), so set this when they differ.
AWS_DATA_REGION=
# DynamoDB Local endpoint (e.g. http://localhost:8000) when DB_DRIVER=dynamodb locally.
DYNAMODB_ENDPOINT=
# Create tables and load demo users into a local database on startup.
SEED_DEMO_DATA=false

# ---- DynamoDB tables (defaults shown) ---------------------------------------------
USERS_TABLE=Users
GRADING_TABLE=assignment_grading
# Optional GSI on assignment_grading (PK assignment_id); recommended for large classes.
GRADING_ASSIGNMENT_INDEX=assignment_id-index
ASSIGNMENTS_TABLE=GradeAnt_Assignments
SUBMISSIONS_TABLE=GradeAnt_Submissions
ANNOUNCEMENTS_TABLE=GradeAnt_Announcements
ADMIN_USERS_TABLE=GradeAnt_Users
RESET_REQUESTS_TABLE=GradeAnt_ResetRequests
CONTENT_TABLE=GradeAnt_Content
TICKETS_TABLE=GradeAnt_Tickets
AUDIT_LOGS_TABLE=GradeAnt_AuditLogs
SETTINGS_TABLE=GradeAnt_Settings
INVITES_TABLE=GradeAnt_Invites
ANALYTICS_TABLE=GradeAnt_Analytics

# ---- Supabase Auth (local development only) -------------------------------------------
# jwt (default: this API issues its own tokens) | supabase (Supabase Auth checks passwords and
# issues tokens; the Users table keeps roles/profiles). Also: npm run dev:supabase.
# Production refuses to start with AUTH_DRIVER=supabase.
AUTH_DRIVER=
# From `npx supabase start` / `npx supabase status -o env`. Put the keys in
# .env.development.local, never in a committed file.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Auth (secrets) ---------------------------------------------------------------
# Production: give the Secrets Manager secret ARN (plain string, or JSON {"JWT_SECRET": "..."}).
# It must be the same secret the Python Lambdas sign with, so existing sessions stay valid.
JWT_SECRET_ARN=
# Development only: the secret itself (put it in .env.development.local, not here).
JWT_SECRET=
TOKEN_EXPIRY_SECONDS=86400
# Admin first-login session tokens (lambda_admin.py's own format).
SESSION_TOKEN_SECRET_ARN=
SESSION_TOKEN_SECRET=
SESSION_TOKEN_TTL_SECONDS=86400
INVITE_TOKEN_TTL_SECONDS=604800

# ---- Storage ----------------------------------------------------------------------
PROFILE_PHOTO_BUCKET=
# /uploadpdf presigned uploads. Leave empty to keep using the existing upload Lambda.
UPLOAD_BUCKET=
# Placeholders: {uploadType} {assignmentId} {qpId} {studentId} {courseId} {fileName} {uuid}
UPLOAD_KEY_TEMPLATE=uploads/{uploadType}/{assignmentId}/{fileName}
UPLOAD_MAX_BYTES=10485760
UPLOAD_URL_TTL_SECONDS=900
LOCAL_STORAGE_DIR=.data/storage

# ---- Email, notifications, jobs, grading pipeline --------------------------------
# From address for reminders (SES-verified). Empty = reminders are not emailed.
SES_SENDER_EMAIL=
# From address for admin invites (defaults to SES_SENDER_EMAIL, then no-reply@gradeant.io).
INVITE_SENDER_EMAIL=
# Base URL of the web app, used in invite links.
APP_BASE_URL=https://app.gradeant.io
# "Grades published" topic. Empty = no notification.
SNS_TOPIC_ARN=
JOBS_QUEUE_URL=
# Lambda that grades one submission (invoked asynchronously). Empty = not triggered.
GRADING_FUNCTION_NAME=
# Answers graded with lower confidence are spot-checked by the teacher.
FLAG_CONFIDENCE=0.75

# ---- Claude on Amazon Bedrock -------------------------------------------------------
BEDROCK_REGION=
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
BEDROCK_FALLBACK_MODEL_ID=anthropic.claude-opus-5
