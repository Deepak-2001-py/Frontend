{
  "name": "gradeant-api",
  "version": "1.0.0",
  "private": true,
  "description": "GradeAnt API \u2014 Node.js + Express, runs locally and on AWS Lambda Web Functions",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch-path=src --watch-path=index.js index.js --mode=development",
    "dev:supabase": "node --watch-path=src --watch-path=index.js index.js --mode=development --auth=supabase",
    "start": "node index.js",
    "start:prod": "node index.js --mode=production",
    "test": "node --test --test-concurrency=1 --test-reporter=spec \"test/*.test.js\"",
    "check:parity": "node scripts/parity.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.35.0",
    "@anthropic-ai/sdk": "^0.135.0",
    "@aws-sdk/client-dynamodb": "^3.1152.0",
    "@aws-sdk/client-lambda": "^3.1152.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/client-secrets-manager": "^3.1152.0",
    "@aws-sdk/client-ses": "^3.1152.0",
    "@aws-sdk/client-sns": "^3.1152.0",
    "@aws-sdk/client-sqs": "^3.1152.0",
    "@aws-sdk/lib-dynamodb": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "dynalite": "^4.0.0"
  }
}
