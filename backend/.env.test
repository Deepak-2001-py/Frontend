# Automated tests (npm test): same local drivers as development, quiet, no demo data.
APP_ENV=test
CORS_ALLOWED_ORIGINS=*
LOG_REQUESTS=false
DB_DRIVER=memory
STORAGE_DRIVER=local
MAIL_DRIVER=log
NOTIFY_DRIVER=log
JOBS_DRIVER=inline
AI_DRIVER=canned
GRADING_DRIVER=log
SEED_DEMO_DATA=false
AWS_DATA_REGION=us-east-1
JWT_SECRET=test-secret-that-is-at-least-32-bytes-long
SESSION_TOKEN_SECRET=test-session-secret-at-least-32-bytes
PROFILE_PHOTO_BUCKET=test-photos
UPLOAD_BUCKET=test-uploads
LOCAL_STORAGE_DIR=.data/test-storage
