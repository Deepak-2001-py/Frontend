# Production on AWS (Lambda Web Functions). No secrets in this file: JWT and
# session secrets come from AWS Secrets Manager (set their ARNs below or as
# revision environment variables, which override this file).
APP_ENV=production
CORS_ALLOWED_ORIGINS=https://app.gradeant.io

DB_DRIVER=dynamodb
STORAGE_DRIVER=s3
MAIL_DRIVER=ses
NOTIFY_DRIVER=sns
JOBS_DRIVER=inline
AI_DRIVER=bedrock
GRADING_DRIVER=lambda

# Region of the existing tables/buckets (the current API runs in eu-north-1).
AWS_DATA_REGION=eu-north-1
BEDROCK_REGION=eu-north-1

JWT_SECRET_ARN=
SESSION_TOKEN_SECRET_ARN=

USERS_TABLE=Users
GRADING_TABLE=assignment_grading
ASSIGNMENTS_TABLE=GradeAnt_Assignments
SUBMISSIONS_TABLE=GradeAnt_Submissions
ANNOUNCEMENTS_TABLE=GradeAnt_Announcements

PROFILE_PHOTO_BUCKET=
# Leave empty until the upload key layout is confirmed (see README); the web app then
# keeps sending uploads to the existing /uploadpdf Lambda via VITE_UPLOAD_BASE_URL.
UPLOAD_BUCKET=

SES_SENDER_EMAIL=
APP_BASE_URL=https://app.gradeant.io
SNS_TOPIC_ARN=
JOBS_QUEUE_URL=
GRADING_FUNCTION_NAME=

BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
BEDROCK_FALLBACK_MODEL_ID=anthropic.claude-opus-5
